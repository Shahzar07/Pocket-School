rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isUser(uid) { return isSignedIn() && request.auth.uid == uid; }
    function incoming() { return request.resource.data; }
    function role() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '')
        : '';
    }
    function myInstitution() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.institutionId; }

    function isAdmin() { return isSignedIn() && role() == 'admin'; }
    function isInstitutionAdmin() { return isSignedIn() && role() == 'institution_admin'; }
    function isTeacherOrAdmin() { return isSignedIn() && role() in ['teacher', 'admin', 'institution_admin']; }

    function isBootstrapAdmin() {
      return isSignedIn()
        && request.auth.token.keys().hasAll(['email'])
        && request.auth.token.email is string
        && (
          request.auth.token.email.lower() == 'harry@poketschool.ai'
          || request.auth.token.email.lower() == 'harry.seggu@gmail.com'
          || request.auth.token.email.lower() == 'shahzarrayyan123@gmail.com'
        );
    }

    // Client writes must never change money, progress, role, or family links.
    // The Admin SDK (API routes) bypasses these rules.
    function privilegedUserFields() {
      return ['role', 'accessTier', 'subscriptionTier', 'permissions',
              'institutionId', 'adminSparksGrantedAt', 'accountStatus',
              'sparksBalance', 'xp', 'sparksMonthlyAllowance', 'sparksGrantedAt',
              'sparksWelcomeGrantedAt', 'childIds', 'emailVerified', 'stripeCustomerId',
              'ageTier', 'dateOfBirth'];
    }

    // Missing ageTier fails closed as under-13. The server is the only writer.
    function callerAgeTier() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('ageTier', 'under13')
        : 'under13';
    }
    function userAgeTier(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('ageTier', 'under13');
    }
    function callerYear() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('yearGroup', '');
    }
    function callerSubjects() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('subjects', []);
    }
    function userRoleOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('role', '');
    }
    function isStaffRole(r) {
      return r == 'teacher' || r == 'admin' || r == 'institution_admin';
    }
    function adultOptIn(uid) {
      return exists(/databases/$(database)/documents/community_profiles/$(uid))
        && get(/databases/$(database)/documents/community_profiles/$(uid)).data.get('adultDmOptIn', false) == true;
    }
    function sameTierPair(a, b) {
      return userAgeTier(a) == userAgeTier(b);
    }
    function bothAdults(a, b) {
      return userAgeTier(a) == 'adult' && userAgeTier(b) == 'adult';
    }
    function dmCreateOk() {
      return incoming().fromId == request.auth.uid
        && incoming().toId is string
        && incoming().toId != request.auth.uid
        && callerAgeTier() == 'adult'
        && bothAdults(incoming().fromId, incoming().toId)
        && (
          isStaffRole(userRoleOf(incoming().fromId))
          || isStaffRole(userRoleOf(incoming().toId))
          || userRoleOf(incoming().fromId) == 'parent'
          || userRoleOf(incoming().toId) == 'parent'
          || (adultOptIn(incoming().fromId) && adultOptIn(incoming().toId))
        );
    }
    function spaceDoc(spaceId) {
      return get(/databases/$(database)/documents/spaces/$(spaceId)).data;
    }
    function onSpaceRoster(data) {
      return data.get('memberIds', []).hasAny([request.auth.uid])
        || data.get('staffIds', []).hasAny([request.auth.uid]);
    }
    function canSeeSpaceData(data) {
      return (
        data.kind == 'class'
        && data.get('staffIds', []).hasAny([request.auth.uid])
        && isTeacherOrAdmin()
      ) || (
        role() != 'parent'
        && data.ageTier == callerAgeTier()
        && (
          (
            callerAgeTier() == 'under13'
            && data.kind in ['class', 'school']
            && onSpaceRoster(data)
          ) || (
            callerAgeTier() == 'teen'
            && (
              (data.kind in ['class', 'school'] && onSpaceRoster(data))
              || (data.kind == 'year' && data.get('year', '') != '' && data.year == callerYear())
              || (data.kind == 'subject' && data.get('subject', '') != '' && callerSubjects().hasAny([data.subject]))
            )
          ) || (
            callerAgeTier() == 'adult'
            && (
              data.get('visibility', 'members') == 'tier'
              || onSpaceRoster(data)
            )
          )
        )
      );
    }
    function canReadChannelData(data) {
      return (
        data.kind == 'class'
        && data.get('staffIds', []).hasAny([request.auth.uid])
        && isTeacherOrAdmin()
      ) || (
        data.ageTier == callerAgeTier()
        && (
          data.get('memberIds', []).hasAny([request.auth.uid])
          || data.get('staffIds', []).hasAny([request.auth.uid])
        )
      );
    }

    function myChildIds() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('childIds', [])
        : [];
    }
    function linkedTo(studentId) {
      return isSignedIn() && studentId is string && myChildIds().hasAny([studentId]);
    }
    function ownsCourse(courseId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/courses/$(courseId))
        && get(/databases/$(database)/documents/courses/$(courseId)).data.ownerId == request.auth.uid;
    }
    function enrolledIn(courseId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/courses/$(courseId)/enrollments/$(request.auth.uid));
    }
    function courseData(courseId) {
      return get(/databases/$(database)/documents/courses/$(courseId)).data;
    }
    function isSelfServe(courseId) {
      return courseData(courseId).kind == 'curriculum'
        || courseData(courseId).get('priceType', '') in ['FREE', 'FREE_PREVIEW', 'SUBSCRIPTION_INCLUDED']
        || courseData(courseId).get('price', 0) == 0;
    }

    function profileCreateFieldsOk() {
      return incoming().keys().hasAll(['role'])
        && incoming().role is string
        && incoming().get('xp', 0) == 0
        && incoming().get('sparksBalance', 0) == 0
        && incoming().get('emailVerified', false) == false
        && !incoming().keys().hasAny([
          'accessTier', 'subscriptionTier', 'permissions', 'institutionId',
          'adminSparksGrantedAt', 'accountStatus', 'sparksMonthlyAllowance',
          'sparksGrantedAt', 'sparksWelcomeGrantedAt', 'childIds', 'stripeCustomerId',
          'ageTier', 'dateOfBirth'
        ]);
    }

    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin() || linkedTo(userId);
      allow create: if isUser(userId)
        && profileCreateFieldsOk()
        && (incoming().role == 'student' || incoming().role == 'teacher' || incoming().role == 'parent');
      allow create: if isUser(userId)
        && profileCreateFieldsOk()
        && incoming().role == 'admin'
        && isBootstrapAdmin();
      allow update: if exists(/databases/$(database)/documents/users/$(userId)) && (
        isAdmin()
        || (isBootstrapAdmin()
            && request.resource.data.role == 'admin'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt', 'email', 'name', 'avatarUrl']))
        || (isUser(userId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(privilegedUserFields()))
      );
      allow delete: if isAdmin();

      match /spark_transactions/{txId} {
        allow read: if isUser(userId) || isAdmin();
        allow write: if false;
      }

      match /ai_generations/{genId} {
        allow read, create: if isUser(userId);
        allow delete: if isUser(userId) || isAdmin();
      }
    }

    // Leaderboards and messaging labels. XP is written only by the server.
    match /public_profiles/{userId} {
      allow read: if isSignedIn() && (
        resource.data.get('ageTier', '') == ''
        || resource.data.get('ageTier', '') == callerAgeTier()
      );
      allow create: if isUser(userId)
        && incoming().get('xp', 0) == 0
        && incoming().get('ageTier', '') == '';
      allow update: if isAdmin()
        || (isUser(userId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['xp', 'ageTier']));
      allow delete: if isAdmin();
    }

    match /programmes/{programmeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /unit_quiz_attempts/{attemptId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid
        || isAdmin()
        || linkedTo(resource.data.studentId)
        || (isTeacherOrAdmin() && ownsCourse(resource.data.courseId))
      );
      allow create, update, delete: if false;
    }

    match /courses/{courseId} {
      allow read: if isSignedIn()
        || (resource.data.status == 'published' && resource.data.isPublic == true);
      allow create: if isAdmin()
        || (isTeacherOrAdmin() && incoming().ownerId == request.auth.uid);
      allow update: if isAdmin()
        || (isTeacherOrAdmin() && resource.data.ownerId == request.auth.uid)
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrollmentCount'])
            && request.resource.data.enrollmentCount == resource.data.get('enrollmentCount', 0) + 1);
      allow delete: if isAdmin();

      match /enrollments/{studentId} {
        allow read: if isUser(studentId)
          || isAdmin()
          || isInstitutionAdmin()
          || ownsCourse(courseId)
          || linkedTo(resource.data.studentId);
        allow create: if (
            isUser(studentId)
            && incoming().studentId == studentId
            && incoming().get('progress', 0) == 0
            && incoming().get('completedLessons', []).size() == 0
            && !incoming().keys().hasAny(['unlockedFormats'])
            && isSelfServe(courseId)
          ) || (
            ownsCourse(courseId) && incoming().studentId == studentId
          ) || isAdmin();
        allow update: if isAdmin() || ownsCourse(courseId);
        allow delete: if isUser(studentId) || isAdmin() || ownsCourse(courseId);
      }

      match /modules/{moduleId} {
        allow read: if true;
        allow create, update: if isAdmin() || isInstitutionAdmin() || ownsCourse(courseId);
        allow delete: if isAdmin();

        match /lessons/{lessonId} {
          allow read: if isAdmin()
            || isInstitutionAdmin()
            || ownsCourse(courseId)
            || (enrolledIn(courseId) && !resource.data.keys().hasAny(['aiOutputs']));
          allow create, update: if isAdmin() || isInstitutionAdmin() || ownsCourse(courseId);
          allow delete: if isAdmin();

          match /protected/{docId} {
            allow read, write: if isAdmin() || isInstitutionAdmin() || ownsCourse(courseId);
          }
        }
      }
    }

    match /coupon_codes/{code} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['usedCount', 'redeemedBy'])
            && request.resource.data.usedCount == resource.data.usedCount + 1
            && request.resource.data.redeemedBy.hasAll(resource.data.redeemedBy)
            && request.auth.uid in request.resource.data.redeemedBy);
    }

    match /coupon_redemptions/{redemptionId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isTeacherOrAdmin());
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && exists(/databases/$(database)/documents/coupon_codes/$(incoming().code))
        && get(/databases/$(database)/documents/coupon_codes/$(incoming().code)).data.active == true
        && get(/databases/$(database)/documents/coupon_codes/$(incoming().code)).data.discountPct >= 100
        && get(/databases/$(database)/documents/coupon_codes/$(incoming().code)).data.courseId == incoming().courseId
        && get(/databases/$(database)/documents/coupon_codes/$(incoming().code)).data.expiresAt == incoming().expiresAt
        && request.time < timestamp.date(
             int(incoming().expiresAt[0:4]),
             int(incoming().expiresAt[5:7]),
             int(incoming().expiresAt[8:10])) + duration.value(1, 'd');
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /institutions/{institutionId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isInstitutionAdmin() && myInstitution() == institutionId);
    }

    match /badges/{badgeId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // Adult-only direct messages. Minors never read or write this collection.
    match /messages/{messageId} {
      allow read: if isSignedIn() && (
        resource.data.fromId == request.auth.uid ||
        resource.data.toId == request.auth.uid
      ) && callerAgeTier() == 'adult'
        && userAgeTier(resource.data.fromId) == 'adult'
        && userAgeTier(resource.data.toId) == 'adult';
      allow create: if isSignedIn() && dmCreateOk();
      allow update: if isSignedIn()
        && resource.data.toId == request.auth.uid
        && callerAgeTier() == 'adult'
        && userAgeTier(resource.data.fromId) == 'adult'
        && userAgeTier(resource.data.toId) == 'adult'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin();
    }

    match /lesson_notes/{noteId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /submissions/{submissionId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid
        || isAdmin()
        || linkedTo(resource.data.studentId)
        || (isTeacherOrAdmin() && ownsCourse(resource.data.courseId))
      );
      allow create: if isSignedIn() && incoming().studentId == request.auth.uid;
      allow update: if isTeacherOrAdmin() && (isAdmin() || ownsCourse(resource.data.courseId));
      allow delete: if isAdmin();
    }

    match /live_classes/{classId} {
      allow read: if isSignedIn();
      allow create, update: if isTeacherOrAdmin();
      allow delete: if isAdmin();
    }

    match /exams/{examId} {
      allow read: if isSignedIn();
      allow create: if isTeacherOrAdmin() && incoming().createdBy == request.auth.uid;
      allow update, delete: if isAdmin() || (isTeacherOrAdmin() && resource.data.createdBy == request.auth.uid);
    }

    match /exam_submissions/{submissionId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid
        || isAdmin()
        || linkedTo(resource.data.studentId)
        || isTeacherOrAdmin()
      );
      allow create: if isSignedIn() && incoming().studentId == request.auth.uid;
      allow update: if isTeacherOrAdmin();
      allow delete: if isAdmin();
    }

    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create: if isTeacherOrAdmin() && incoming().createdBy == request.auth.uid;
      allow update, delete: if isAdmin() || (isTeacherOrAdmin() && resource.data.createdBy == request.auth.uid);
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn() && (
        resource.data.get('status', 'published') == 'published'
        || resource.data.createdBy == request.auth.uid
        || isAdmin()
      );
      allow create: if isTeacherOrAdmin() && incoming().createdBy == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    match /calendar_events/{eventId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacherOrAdmin();
    }

    match /resources/{resourceId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacherOrAdmin();
    }

    match /support_tickets/{ticketId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /behaviour_records/{recordId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.studentId == request.auth.uid
        || resource.data.recordedBy == request.auth.uid
        || linkedTo(resource.data.studentId)
      );
      allow create: if isTeacherOrAdmin() && incoming().recordedBy == request.auth.uid;
      allow update: if isAdmin() || resource.data.recordedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /attendance/{recordId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.get('teacherId', '') == request.auth.uid
        || resource.data.get('studentId', '') == request.auth.uid
        || linkedTo(resource.data.get('studentId', ''))
      );
      allow create, update: if isTeacherOrAdmin();
      allow delete: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid
        || resource.data.createdBy == request.auth.uid
        || isAdmin()
        || linkedTo(resource.data.studentId)
      );
      allow create: if isTeacherOrAdmin() && incoming().createdBy == request.auth.uid;
      allow update: if isAdmin() || resource.data.createdBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /report_cards/{cardId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.studentId == request.auth.uid
        || resource.data.get('teacherId', '') == request.auth.uid
        || linkedTo(resource.data.studentId)
      );
      allow create, update: if isTeacherOrAdmin();
      allow delete: if isAdmin();
    }

    match /integrity_reports/{reportId} {
      allow read: if isTeacherOrAdmin();
      allow create, update: if isTeacherOrAdmin();
      allow delete: if isAdmin();
    }

    match /certificates/{certId} {
      allow get: if true;
      allow list: if isSignedIn() && (
        resource.data.studentId == request.auth.uid
        || isTeacherOrAdmin()
        || linkedTo(resource.data.studentId)
      );
      allow create: if isTeacherOrAdmin();
      allow delete: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.assignedTo == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        incoming().userId == request.auth.uid || incoming().createdBy == request.auth.uid
      );
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || resource.data.assignedTo == request.auth.uid
        || resource.data.createdBy == request.auth.uid
        || isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    match /daily_goals/{goalId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid
        || isAdmin()
        || linkedTo(resource.data.studentId)
      );
      allow create: if isSignedIn() && incoming().studentId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.studentId == request.auth.uid
        || isAdmin()
        || linkedTo(resource.data.studentId)
      );
      allow delete: if isSignedIn() && (
        resource.data.studentId == request.auth.uid || isAdmin()
      );
    }

    match /grades/{gradeId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid
        || isAdmin()
        || linkedTo(resource.data.studentId)
        || (isTeacherOrAdmin() && ownsCourse(resource.data.courseId))
      );
      allow create: if isAdmin() || isInstitutionAdmin() || (isTeacherOrAdmin() && ownsCourse(incoming().courseId));
      allow update: if isAdmin() || isInstitutionAdmin() || (isTeacherOrAdmin() && ownsCourse(resource.data.courseId));
      allow delete: if isAdmin();
    }

    match /grade_weights/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || ownsCourse(courseId);
    }

    match /assignment_submissions/{submissionId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid
        || isAdmin()
        || linkedTo(resource.data.studentId)
        || (isTeacherOrAdmin() && ownsCourse(resource.data.courseId))
      );
      allow create: if isSignedIn() && incoming().studentId == request.auth.uid;
      allow update: if isTeacherOrAdmin() && (isAdmin() || ownsCourse(resource.data.courseId));
      allow delete: if isAdmin();
    }

    match /attendance_records/{recordId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.teacherId == request.auth.uid
        || ownsCourse(resource.data.courseId)
        || resource.data.get('studentIds', []).hasAny([request.auth.uid])
        || resource.data.get('studentIds', []).hasAny(myChildIds())
      );
      allow create: if isTeacherOrAdmin() && (isAdmin() || incoming().teacherId == request.auth.uid);
      allow update: if isTeacherOrAdmin() && (isAdmin() || resource.data.teacherId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && (
        incoming().userId == request.auth.uid || isTeacherOrAdmin()
      );
    }

    match /chat_messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().senderId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /teacher_notifications/{teacherId}/emails/{emailId} {
      allow create: if isSignedIn();
      allow read: if isTeacherOrAdmin();
      allow update, delete: if isAdmin();
    }

    match /parent_verifications/{verificationId} {
      allow create: if isSignedIn() && incoming().parentId == request.auth.uid;
      allow read, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /parent_links/{linkId} {
      allow create: if isSignedIn()
        && incoming().parentId == request.auth.uid
        && incoming().status == 'pending'
        && !incoming().keys().hasAny(['studentName']);
      allow read: if isSignedIn() && (
        resource.data.parentId == request.auth.uid
        || resource.data.studentId == request.auth.uid
        || isAdmin()
      );
      allow update: if isSignedIn()
        && resource.data.studentId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'rejected'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if isAdmin();
    }

    match /platform_settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /user_sessions/{sessionId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Push tokens for the notification sender. Owner writes, sender reads via Admin SDK.
    match /users/{userId}/deviceTokens/{tokenId} {
      allow read: if isUser(userId) || isAdmin();
      allow create, update: if isUser(userId)
        && incoming().token is string
        && incoming().token.size() > 0
        && incoming().token.size() < 4096
        && incoming().platform in ['ios', 'android', 'web'];
      allow delete: if isUser(userId) || isAdmin();
    }

    match /community_profiles/{userId} {
      allow read: if isSignedIn() && resource.data.ageTier == callerAgeTier();
      allow create: if isUser(userId)
        && incoming().ageTier == callerAgeTier()
        && incoming().ageTier in ['under13', 'teen', 'adult'];
      allow update: if isUser(userId)
        && request.resource.data.ageTier == resource.data.ageTier
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'bio', 'isPublic', 'adultDmOptIn', 'updatedAt']);
      allow delete: if isAdmin();
    }

    match /spaces/{spaceId} {
      allow read: if isSignedIn() && canSeeSpaceData(resource.data);
      allow create, update, delete: if false;
    }

    match /posts/{postId} {
      allow read: if isSignedIn() && (
        resource.data.authorId == request.auth.uid
        || (resource.data.moderation == 'allow' && canSeeSpaceData(spaceDoc(resource.data.spaceId)))
      );
      allow create, update, delete: if false;
    }

    match /comments/{commentId} {
      allow read: if isSignedIn() && (
        resource.data.authorId == request.auth.uid
        || (resource.data.moderation == 'allow' && canSeeSpaceData(spaceDoc(resource.data.spaceId)))
      );
      allow create, update, delete: if false;
    }

    match /reactions/{reactionId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || canSeeSpaceData(spaceDoc(get(/databases/$(database)/documents/posts/$(resource.data.postId)).data.spaceId))
      );
      allow create, update, delete: if false;
    }

    match /follows/{followId} {
      allow read: if isSignedIn()
        && role() != 'parent'
        && (resource.data.followerId == request.auth.uid || resource.data.targetId == request.auth.uid)
        && resource.data.followerAgeTier == resource.data.targetAgeTier
        && resource.data.followerAgeTier == callerAgeTier();
      allow create: if isSignedIn()
        && role() != 'parent'
        && incoming().followerId == request.auth.uid
        && incoming().followerAgeTier == callerAgeTier()
        && incoming().targetAgeTier == userAgeTier(incoming().targetId)
        && incoming().followerAgeTier == incoming().targetAgeTier
        && incoming().targetId != request.auth.uid;
      allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    match /reports/{reportId} {
      allow read: if isSignedIn() && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && incoming().reporterId == request.auth.uid
        && incoming().reporterAgeTier == callerAgeTier()
        && incoming().status == 'open';
      allow update, delete: if isAdmin();
    }

    match /moderation_queue/{itemId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /parent_controls/{studentId} {
      allow read: if isUser(studentId) || linkedTo(studentId) || isAdmin();
      allow create, update: if linkedTo(studentId)
        && incoming().studentId == studentId
        && incoming().communityEnabled is bool
        && incoming().messagingEnabled is bool
        && incoming().snapEnabled is bool;
      allow delete: if isAdmin();
    }

    match /channels/{channelId} {
      allow read: if isSignedIn() && canReadChannelData(resource.data);
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && canReadChannelData(get(/databases/$(database)/documents/channels/$(channelId)).data);
        allow create, update, delete: if false;
      }
    }

    match /tutor_profiles/{userId} {
      allow read: if isSignedIn()
        && resource.data.ageTier == 'adult'
        && resource.data.verificationStatus == 'verified';
      allow create: if isUser(userId)
        && callerAgeTier() == 'adult'
        && incoming().ageTier == 'adult'
        && incoming().verificationStatus == 'pending';
      allow update: if isUser(userId)
        && resource.data.ageTier == 'adult'
        && request.resource.data.ageTier == 'adult'
        && request.resource.data.verificationStatus == resource.data.verificationStatus
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['bio', 'subjects', 'hourlyCents', 'currency', 'updatedAt']);
      allow delete: if isAdmin();
    }

    match /tutor_bookings/{bookingId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid
        || resource.data.tutorId == request.auth.uid
        || isAdmin()
      );
      allow create, update, delete: if false;
    }

    match /tutor_reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /exam_papers/{paperId} {
      allow read: if isSignedIn()
        && resource.data.status == 'published'
        && resource.data.license in ['licensed', 'teacher_upload'];
      allow create: if isTeacherOrAdmin()
        && incoming().license == 'teacher_upload'
        && incoming().uploadedBy == request.auth.uid
        && incoming().status == 'draft';
      allow update: if isAdmin()
        || (isTeacherOrAdmin()
            && resource.data.uploadedBy == request.auth.uid
            && resource.data.license == 'teacher_upload'
            && request.resource.data.license == 'teacher_upload');
      allow delete: if isAdmin();
    }

    match /mock_attempts/{attemptId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid
        || isAdmin()
        || linkedTo(resource.data.studentId)
      );
      allow create, update, delete: if false;
    }

    match /guidance_profiles/{userId} {
      allow read: if isUser(userId) || isAdmin() || linkedTo(userId);
      allow create, update, delete: if false;
    }

    match /creator_resources/{resourceId} {
      allow read: if isSignedIn() && (
        resource.data.status == 'approved'
        || resource.data.authorId == request.auth.uid
        || isAdmin()
      );
      allow create: if isTeacherOrAdmin()
        && incoming().authorId == request.auth.uid
        && incoming().status == 'draft'
        && incoming().kind in ['note', 'worksheet', 'template'];
      allow update: if isAdmin()
        || (resource.data.authorId == request.auth.uid
            && resource.data.status in ['draft', 'pending', 'rejected']
            && request.resource.data.status in ['draft', 'pending']
            && request.resource.data.authorId == resource.data.authorId);
      allow delete: if isAdmin() || resource.data.authorId == request.auth.uid;
    }

    match /snap_sessions/{sessionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    match /lesson_questions/{questionId} {
      allow read: if isSignedIn() && (
        resource.data.authorId == request.auth.uid
        || isAdmin()
        || linkedTo(resource.data.authorId)
      );
      allow create, update, delete: if false;
    }
  }
}
