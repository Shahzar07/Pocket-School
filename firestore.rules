rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Default deny ─────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Helpers ───────────────────────────────────────────────
    function isSignedIn() { return request.auth != null; }
    function isUser(uid) { return isSignedIn() && request.auth.uid == uid; }
    function incoming() { return request.resource.data; }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function userData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    // Membership. The open dashboard is not stored here and is not read.
    // Admin stays on the singular role so a roles array cannot grant it.
    function hasRole(name) {
      return isSignedIn() && (
        role() == name
        || (userData().keys().hasAny(['roles'])
            && userData().roles is list
            && userData().roles.hasAny([name]))
      );
    }
    function myInstitution() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.institutionId; }

    // Platform-wide administrator. Deliberately NOT widened to include
    // institution admins: this gates platform switches (settings, deleting
    // users and institutions) that a single school must not control.
    function isAdmin() { return isSignedIn() && role() == 'admin'; }

    // Scoped to one institution. Gets teacher-grade capability so they can run
    // their school's courses, grades, attendance and reports.
    function isInstitutionAdmin() { return isSignedIn() && role() == 'institution_admin'; }

    function tenantStaff(institutionId) {
      return isAdmin() || (isInstitutionAdmin() && myInstitution() == institutionId);
    }
    function tenantReader(institutionId) {
      return isAdmin() || (isSignedIn() && myInstitution() == institutionId);
    }
    function sameText(field) {
      return incoming().get(field, '') == resource.data.get(field, '');
    }
    function sameNumber(field) {
      return incoming().get(field, 0) == resource.data.get(field, 0);
    }
    function sameBool(field) {
      return incoming().get(field, false) == resource.data.get(field, false);
    }
    function planAllowsWhiteLabel() {
      return resource.data.get('plan', '') == 'enterprise' || resource.data.get('plan', '') == 'oem';
    }
    function hidePoweredUnchanged() {
      return incoming().get('branding', {}).get('hidePoweredBy', false)
        == resource.data.get('branding', {}).get('hidePoweredBy', false);
    }
    function customDomainUnchanged() {
      return incoming().get('customDomain', '') == resource.data.get('customDomain', '');
    }

    function isTeacherOrAdmin() { return isSignedIn() && (hasRole('teacher') || role() == 'admin' || role() == 'institution_admin'); }

    function audienceGated(data) {
      return data.keys().hasAny(['audiences'])
        && data.audiences is list
        && data.audiences.size() > 0;
    }

    // Signed-in audience match. Marketplace is public and is checked separately
    // so a guest can read a sales page.
    function audienceHit(data) {
      return data.audiences.hasAny(['all'])
        || (hasRole('student') && data.audiences.hasAny(['students']))
        || (hasRole('teacher') && data.audiences.hasAny(['teachers']))
        || (hasRole('parent') && data.audiences.hasAny(['parents']))
        || data.audiences.hasAny(['marketplace'])
        || (data.audiences.hasAny(['institutions'])
            && myInstitution() != null
            && data.get('allocatedInstitutionIds', []).hasAny([myInstitution()]))
        || (targetsGated(data) && targetsHit(data));
    }

    function targetsGated(data) {
      return data.keys().hasAny(['targets'])
        && data.targets is list
        && data.targets.size() > 0;
    }

    function scopeGated(data) {
      return data.keys().hasAny(['publishScope'])
        && data.publishScope in ['institution', 'public', 'marketplace'];
    }

    // Any target is enough: a role, a named person, a class, a parent, a
    // school, or the marketplace. Class ids are also stored on classIds.
    function targetsHit(data) {
      return data.targets.hasAny(['marketplace'])
        || (isSignedIn() && (
          data.targets.hasAny(['all'])
          || (hasRole('student') && data.targets.hasAny(['students']))
          || (hasRole('teacher') && data.targets.hasAny(['teachers']))
          || (hasRole('parent') && data.targets.hasAny(['parents']))
          || data.targets.hasAny(['user:' + request.auth.uid])
          || data.targets.hasAny(['parent:' + request.auth.uid])
          || (myInstitution() != null && data.targets.hasAny(['institution:' + myInstitution()]))
          || (myInstitution() != null
              && data.targets.hasAny(['institutions'])
              && data.get('allocatedInstitutionIds', []).size() == 0)
          || (myInstitution() != null
              && data.get('allocatedInstitutionIds', []).hasAny([myInstitution()]))
          || (data.get('classIds', []).size() > 0
              && userDoc().get('cohortIds', []).hasAny(data.get('classIds', [])))
        ));
    }

    function scopeHit(data) {
      return data.publishScope == 'public'
        || data.publishScope == 'marketplace'
        || (isSignedIn()
            && data.publishScope == 'institution'
            && myInstitution() != null
            && data.get('allocatedInstitutionIds', []).hasAny([myInstitution()]));
    }

    // Fields a user must never be able to set on their own profile. Writing
    // any of these is privilege escalation: role grants the admin console,
    // accessTier and subscriptionTier unlock paid content, permissions can
    // carry alloc:free:* for any course, and institutionId joins someone
    // else's school. Only an admin may change them.
    function privilegedUserFields() {
      // childIds is not a profile field. A parent may only remove a linked
      // child. A student may add only their own id after they approve a link.
      // Wallet and XP stay off the profile form. Lesson rewards still write
      // them through walletProgressUpdate(), not through a profile save.
      return ['role', 'accessTier', 'subscriptionTier', 'permissions',
              'institutionId', 'adminSparksGrantedAt', 'accountStatus',
              'adminRole', 'statusReason', 'deletedAt', 'cohortIds',
              'ageTier', 'dateOfBirth', 'emailVerified', 'phoneVerified',
              'verification', 'partnerKind',
              'sparksBalance', 'sparksMonthlyAllowance', 'sparksGrantedAt',
              'sparksWelcomeGrantedAt', 'xp', 'stripeCustomerId', 'stripeAccountId',
              'studentNumber', 'referralCode', 'cardShareId', 'cardIndexed', 'cardSharing',
              'studentStatus', 'partnerId'];
    }

    // Profile & settings. Keep this list aligned with SELF_SERVICE_FIELDS
    // in lib/account-settings.ts. A profile save cannot also change a
    // privileged field, because the changed keys must be only these.
    function selfServiceFields() {
      return ['name', 'displayName', 'bio', 'avatarUrl', 'photoStoragePath',
              'country', 'timezone', 'phone', 'language', 'currency',
              'level', 'learningStyle', 'yearGroup', 'interests', 'shareBoard',
              'notificationPrefs', 'privacy', 'instructor',
              'twoFactorEnabled', 'sessionsRevokedAt', 'deletionRequest',
              'email', 'updatedAt', 'onboardedAt', 'studyDates',
              'lastActiveAt', 'region', 'parentContacts',
              'emergencyOptIn', 'currentCountry', 'homeCountry',
              'dashboardTileOrder', 'dashboardCoachSeen'];
    }

    function verificationUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verification', 'partnerKind']);
    }

    function deletionRequestOk() {
      let next = incoming().get('deletionRequest', null);
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deletionRequest'])
        || next == null
        || (next is map
            && next.keys().hasOnly(['requestedAt', 'scheduledFor'])
            && next.requestedAt is number
            && next.scheduledFor is number
            && next.scheduledFor >= next.requestedAt + 1123200000
            && next.scheduledFor <= next.requestedAt + 1296000000);
    }

    function selfProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(selfServiceFields())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['email'])
            || incoming().get('email', '') == request.auth.token.email)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['emergencyOptIn'])
            || incoming().emergencyOptIn is bool)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['homeCountry'])
            || incoming().homeCountry is string)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['currentCountry'])
            || incoming().currentCountry is string)
        && deletionRequestOk();
    }

    function walletProgressUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['sparksBalance', 'xp', 'sparksGrantedAt', 'updatedAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['sparksBalance'])
            || incoming().sparksBalance is number)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['xp'])
            || incoming().xp is number);
    }

    // Missing ageTier fails closed as under-13. The server is the only writer.
    function callerAgeTier() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('ageTier', 'under13')
        : 'under13';
    }
    function userAgeTier(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('ageTier', 'under13');
    }
    function userRoleOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('role', '');
    }
    function callerYear() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('yearGroup', '');
    }
    function callerSubjects() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('subjects', []);
    }
    function isStaffRole(r) {
      return r == 'teacher' || r == 'admin' || r == 'institution_admin';
    }
    function adultOptIn(uid) {
      return exists(/databases/$(database)/documents/community_profiles/$(uid))
        && get(/databases/$(database)/documents/community_profiles/$(uid)).data.get('adultDmOptIn', false) == true;
    }
    function myChildIds() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('childIds', [])
        : [];
    }
    function linkedTo(studentId) {
      return isSignedIn() && studentId is string && myChildIds().hasAny([studentId]);
    }
    function dmCreateOk() {
      return incoming().fromId == request.auth.uid
        && incoming().toId is string
        && incoming().toId != request.auth.uid
        && callerAgeTier() == 'adult'
        && userAgeTier(incoming().fromId) == 'adult'
        && userAgeTier(incoming().toId) == 'adult'
        && (
          isStaffRole(userRoleOf(incoming().fromId))
          || isStaffRole(userRoleOf(incoming().toId))
          || userRoleOf(incoming().fromId) == 'parent'
          || userRoleOf(incoming().toId) == 'parent'
          || (adultOptIn(incoming().fromId) && adultOptIn(incoming().toId))
        );
    }
    function spaceDoc(spaceId) {
      return get(/databases/$(database)/documents/spaces/$(spaceId)).data;
    }
    function onSpaceRoster(data) {
      return data.get('memberIds', []).hasAny([request.auth.uid])
        || data.get('staffIds', []).hasAny([request.auth.uid]);
    }

    function canReadChannelData(data) {
      return (
        data.kind == 'class'
        && data.get('staffIds', []).hasAny([request.auth.uid])
        && isTeacherOrAdmin()
      ) || (
        data.ageTier == callerAgeTier()
        && (
          data.get('memberIds', []).hasAny([request.auth.uid])
          || data.get('staffIds', []).hasAny([request.auth.uid])
        )
      );
    }
    function canSeeSpaceData(data) {
      return (
        data.kind == 'class'
        && data.get('staffIds', []).hasAny([request.auth.uid])
        && isTeacherOrAdmin()
      ) || (
        role() != 'parent'
        && data.ageTier == callerAgeTier()
        && (
          (
            callerAgeTier() == 'under13'
            && data.kind in ['class', 'school']
            && onSpaceRoster(data)
          ) || (
            callerAgeTier() == 'teen'
            && (
              (data.kind in ['class', 'school'] && onSpaceRoster(data))
              || (data.kind == 'year' && data.get('year', '') != '' && data.year == callerYear())
              || (data.kind == 'subject' && data.get('subject', '') != '' && callerSubjects().hasAny([data.subject]))
            )
          ) || (
            callerAgeTier() == 'adult'
            && (
              data.get('visibility', 'members') == 'tier'
              || onSpaceRoster(data)
            )
          )
        )
      );
    }

    function callerIsSuper() {
      return isSignedIn() && (
        request.auth.token.adminRole == 'super_admin'
        || request.auth.token.email == 'shahzarrayyan123@gmail.com'
        || request.auth.token.email == 'harry.seggu@gmail.com'
        || request.auth.token.email == 'harry@poketschool.ai'
      );
    }

    function targetIsSuper() {
      return resource.data.get('adminRole', '') == 'super_admin'
        || resource.data.get('email', '') == 'shahzarrayyan123@gmail.com'
        || resource.data.get('email', '') == 'harry.seggu@gmail.com'
        || resource.data.get('email', '') == 'harry@poketschool.ai';
    }

    // A regular admin can change users. Promoting someone to super admin, or
    // editing a super admin, requires the super admin claim or the owner email.
    function staffWriteAllowed() {
      return callerIsSuper()
        || (
          !targetIsSuper()
          && incoming().get('adminRole', '') != 'super_admin'
        );
    }

    // A parent can drop a child from their own list. They cannot add one.
    function parentUnlink(userId) {
      return isUser(userId)
        && hasRole('parent')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['childIds', 'updatedAt'])
        && resource.data.get('childIds', []) is list
        && incoming().childIds is list
        && resource.data.get('childIds', []).hasAll(incoming().childIds)
        && incoming().childIds.size() < resource.data.get('childIds', []).size();
    }

    // After the link document is approved, the student adds only their own id.
    function childJoinsParent(userId) {
      return isSignedIn()
        && request.auth.uid != userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['childIds', 'updatedAt'])
        && resource.data.get('childIds', []) is list
        && incoming().childIds is list
        && incoming().childIds.hasAll(resource.data.get('childIds', []))
        && incoming().childIds.size() == resource.data.get('childIds', []).size() + 1
        && incoming().childIds.hasAny([request.auth.uid])
        && !resource.data.get('childIds', []).hasAny([request.auth.uid])
        && exists(/databases/$(database)/documents/parent_links/$(userId + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/parent_links/$(userId + '_' + request.auth.uid)).data.status == 'approved'
        && get(/databases/$(database)/documents/parent_links/$(userId + '_' + request.auth.uid)).data.studentId == request.auth.uid
        && get(/databases/$(database)/documents/parent_links/$(userId + '_' + request.auth.uid)).data.parentId == userId;
    }

    function switchableRoleList(list) {
      return list is list
        && list.size() >= 1
        && list.size() <= 3
        && list.hasOnly(['student', 'teacher', 'parent']);
    }

    function keptRoles() {
      return !resource.data.keys().hasAny(['roles'])
        || (resource.data.roles is list && incoming().roles.hasAll(resource.data.roles));
    }

    // roles is not a profile field. A teacher or parent may add student.
    // A learner may add teacher. Admin cannot be written here.
    function rolesOnly(userId) {
      return isUser(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roles', 'updatedAt'])
        && switchableRoleList(incoming().roles)
        && keptRoles()
        && resource.data.role in ['student', 'teacher', 'parent'];
    }

    function claimLearnerSpace(userId) {
      return rolesOnly(userId)
        && resource.data.role in ['teacher', 'parent']
        && incoming().roles.hasAny(['student'])
        && incoming().roles.hasAny([resource.data.role])
        && (
          resource.data.role == 'teacher'
          || (resource.data.keys().hasAny(['roles']) && resource.data.roles.hasAny(['teacher']))
          || !incoming().roles.hasAny(['teacher'])
        );
    }

    function becomeInstructor(userId) {
      return rolesOnly(userId)
        && resource.data.role != 'teacher'
        && !(resource.data.keys().hasAny(['roles']) && resource.data.roles.hasAny(['teacher']))
        && (resource.data.role == 'student'
            || resource.data.role == 'parent'
            || (resource.data.keys().hasAny(['roles']) && resource.data.roles.hasAny(['student'])))
        && incoming().roles.hasAll(['student', 'teacher'])
        && (resource.data.role != 'parent' || incoming().roles.hasAny(['parent']));
    }

    // A linked parent may edit name, bio, and photo only when ageTier is under13.
    function parentEditsUnder13(userId) {
      return isSignedIn()
        && hasRole('parent')
        && linkedTo(userId)
        && resource.data.get('ageTier', '') == 'under13'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'displayName', 'bio', 'avatarUrl', 'photoStoragePath', 'updatedAt']);
    }

    function studentGoalUpdate() {
      return resource.data.studentId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['sparksAwarded', 'cosignedBy', 'cosignedAt', 'excusedBy', 'excuseReason', 'reactions']);
    }
    function parentGoalUpdate() {
      return linkedTo(resource.data.studentId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'excuseReason', 'excusedBy', 'notifiedMissed', 'cosignedBy', 'cosignedAt', 'parentNote', 'reactions'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || request.resource.data.status == 'excused'
        );
    }
    function teacherMayReadGoal() {
      return resource.data.get('shareWithTeachers', true) != false
        && resource.data.get('teacherIds', []).hasAny([request.auth.uid]);
    }

    // ── Users ─────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      // Signup may store dateOfBirth. ageTier and Stripe ids are server-only, including on create.
      allow create: if isUser(userId)
        && !incoming().keys().hasAny(['ageTier', 'stripeAccountId', 'stripeCustomerId', 'verification', 'partnerKind', 'studentNumber', 'referralCode', 'cardShareId', 'cardIndexed', 'cardSharing', 'studentStatus', 'partnerId']);
      allow update: if verificationUntouched()
        && ((isAdmin() && staffWriteAllowed()
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentNumber', 'referralCode', 'cardShareId', 'cardIndexed', 'cardSharing', 'studentStatus', 'partnerId']))
        || (isUser(userId) && selfProfileUpdate())
        || (isUser(userId) && walletProgressUpdate())
        || parentUnlink(userId)
        || childJoinsParent(userId)
        || parentEditsUnder13(userId)
        || claimLearnerSpace(userId)
        || becomeInstructor(userId)
        // The institution admin attaches a person only after approving their join request.
        || (isInstitutionAdmin()
            && myInstitution() is string
            && myInstitution() != ''
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['institutionId', 'level', 'cohortIds', 'updatedAt'])
            && incoming().institutionId == myInstitution()
            && resource.data.get('institutionId', '') == ''
            && exists(/databases/$(database)/documents/institutions/$(myInstitution())/join_requests/$(userId))
            && get(/databases/$(database)/documents/institutions/$(myInstitution())/join_requests/$(userId)).data.status == 'approved'
            && get(/databases/$(database)/documents/institutions/$(myInstitution())/join_requests/$(userId)).data.userId == userId)
        // A person may join the one school that invited their email.
        || (isUser(userId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['institutionId'])
            && incoming().institutionId is string
            && exists(/databases/$(database)/documents/institutions/$(incoming().institutionId)/invites/$(request.auth.token.email))));
      allow delete: if isAdmin();

      // Payout details and the payment method. The user document itself is
      // readable by any signed-in person so class screens can show a name.
      // Card numbers and bank details are not. Billing stores brand, last4,
      // expiry, and the name on the card.
      match /private/{docId} {
        allow read, write: if isUser(userId);
      }

      // Limits for one linked child. The child can read them. Only the parent
      // who already has that child in childIds can write them.
      match /child_controls/{childId} {
        allow read: if isUser(userId) || isUser(childId) || isAdmin();
        allow create, update: if isUser(userId)
          && hasRole('parent')
          && myChildIds().hasAny([childId])
          && incoming().childId == childId
          && incoming().weeklyReportEmail is bool
          && incoming().weeklyReportInApp is bool
          && incoming().screenTimeMinutes is number
          && incoming().screenTimeMinutes >= 0
          && incoming().screenTimeMinutes <= 1440
          && incoming().sparksDailyLimit is number
          && incoming().sparksDailyLimit >= 0
          && incoming().purchaseApproval is bool
          && incoming().teacherMessages in ['all', 'digest', 'off']
          && (!incoming().keys().hasAny(['goalPush']) || incoming().goalPush is bool)
          && (!incoming().keys().hasAny(['digestCadence']) || incoming().digestCadence in ['off', 'daily', 'weekly']);
        allow delete: if isUser(userId) && hasRole('parent');
      }

      // Sparks wallet ledger
      match /spark_transactions/{txId} {
        allow read, create: if isUser(userId) || isAdmin();
        allow update, delete: if isAdmin();
      }

      // Per-user push tokens written by the Poketschool app.
      // The path owner is the signed-in user, so a missing userId field is still theirs.
      match /deviceTokens/{tokenId} {
        allow read: if false;
        allow create, update, delete: if isUser(userId);
      }

      // Login rows copied for My login activity. The Admin SDK writes them.
      match /auth_activity/{eventId} {
        allow read: if isUser(userId) || callerIsSuper();
        allow create, update, delete: if false;
      }
    }

    // ── Programmes (curriculum) ───────────────────────────────
    match /programmes/{programmeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ── Unit mastery quiz attempts ────────────────────────────
    match /unit_quiz_attempts/{attemptId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid
        || isTeacherOrAdmin()
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childIds.hasAny([resource.data.studentId])
      );
      allow create: if isSignedIn() && incoming().studentId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── Product access policy ────────────────────────────────
    // A policy is active when include is a non-empty list. Courses without
    // one keep the audience rules above. Country and region stay writable by
    // the user, so a region gate can be self-reported. Seat and analytics
    // counters move by a fixed step; a client can still repeat that step.
    function policyOn(data) {
      return data.keys().hasAny(['accessPolicy'])
        && data.accessPolicy is map
        && data.accessPolicy.keys().hasAny(['include'])
        && data.accessPolicy.include is list
        && data.accessPolicy.include.size() > 0;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasItems(data, key) {
      return data.accessPolicy.keys().hasAny([key])
        && data.accessPolicy[key] is list
        && data.accessPolicy[key].size() > 0;
    }

    function targetingEmpty(data) {
      return !hasItems(data, 'programmeIds')
        && !hasItems(data, 'yearGroups')
        && !hasItems(data, 'levels')
        && !hasItems(data, 'countries')
        && !hasItems(data, 'regions')
        && !hasItems(data, 'languages');
    }

    function targeted(data) {
      return (!hasItems(data, 'programmeIds') || data.accessPolicy.programmeIds.hasAny([userDoc().get('programmeId', '')]))
        && (!hasItems(data, 'yearGroups') || data.accessPolicy.yearGroups.hasAny([userDoc().get('yearGroup', '')]))
        && (!hasItems(data, 'levels') || data.accessPolicy.levels.hasAny([userDoc().get('level', '')]))
        && (!hasItems(data, 'countries') || data.accessPolicy.countries.hasAny([userDoc().get('country', '').upper()]))
        && (!hasItems(data, 'regions') || data.accessPolicy.regions.hasAny([userDoc().get('region', '')]))
        && (!hasItems(data, 'languages') || data.accessPolicy.languages.hasAny([userDoc().get('language', 'en')]));
    }

    function uidGrant(courseId) {
      return exists(/databases/$(database)/documents/courses/$(courseId)/grants/$(request.auth.uid))
        && get(/databases/$(database)/documents/courses/$(courseId)/grants/$(request.auth.uid)).data.get('active', true) != false;
    }

    function emailGrant(courseId) {
      return request.auth.token.email is string
        && exists(/databases/$(database)/documents/courses/$(courseId)/grants/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/courses/$(courseId)/grants/$(request.auth.token.email.lower())).data.get('active', true) != false;
    }

    function grantActive(courseId) {
      return isSignedIn() && (uidGrant(courseId) || emailGrant(courseId));
    }

    function institutionIncluded(data) {
      return myInstitution() != null
        && !data.accessPolicy.get('excludeInstitutionIds', []).hasAny([myInstitution()])
        && (data.accessPolicy.get('institutionMode', 'specific') == 'all'
            || data.accessPolicy.get('institutionIds', []).hasAny([myInstitution()])
            || data.get('allocatedInstitutionIds', []).hasAny([myInstitution()]));
    }

    function includeHit(data, courseId) {
      return data.accessPolicy.include.hasAny(['marketplace'])
        || (targetsGated(data) && targetsHit(data))
        || (isSignedIn() && (
          data.accessPolicy.include.hasAny(['all'])
          || (hasRole('student') && data.accessPolicy.include.hasAny(['students']))
          || (hasRole('teacher') && data.accessPolicy.include.hasAny(['teachers']))
          || (hasRole('parent') && data.accessPolicy.include.hasAny(['parents']))
          || (data.accessPolicy.include.hasAny(['institutions']) && institutionIncluded(data))
          || (data.accessPolicy.include.hasAny(['users']) && data.accessPolicy.get('userIds', []).hasAny([request.auth.uid]))
          || (data.accessPolicy.include.hasAny(['cohorts']) && userDoc().get('cohortIds', []).hasAny(data.accessPolicy.get('cohortIds', [])))
          || grantActive(courseId)
        ));
    }

    function excludeHit(data) {
      return (!isSignedIn() && data.accessPolicy.get('exclude', []).hasAny(['marketplace']))
        || (isSignedIn() && (
          data.accessPolicy.get('exclude', []).hasAny(['all'])
          || data.accessPolicy.get('excludeUserIds', []).hasAny([request.auth.uid])
          || (myInstitution() != null && data.accessPolicy.get('excludeInstitutionIds', []).hasAny([myInstitution()]))
          || userDoc().get('cohortIds', []).hasAny(data.accessPolicy.get('excludeCohortIds', []))
          || (hasRole('student') && data.accessPolicy.get('exclude', []).hasAny(['students']))
          || (hasRole('teacher') && data.accessPolicy.get('exclude', []).hasAny(['teachers']))
          || (hasRole('parent') && data.accessPolicy.get('exclude', []).hasAny(['parents']))
          || (data.accessPolicy.get('exclude', []).hasAny(['institutions']) && myInstitution() != null
              && (data.accessPolicy.get('institutionMode', 'specific') == 'all'
                  || data.accessPolicy.get('institutionIds', []).hasAny([myInstitution()])))
        ));
    }

    function enrolledHere(courseId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/courses/$(courseId)/enrollments/$(request.auth.uid));
    }

    function enrollmentStart(courseId) {
      let enrolledAt = get(/databases/$(database)/documents/courses/$(courseId)/enrollments/$(request.auth.uid)).data.enrolledAt;
      return timestamp.date(enrolledAt.year(), enrolledAt.month(), enrolledAt.day());
    }

    function isoReady(value) {
      return value is string && value.size() >= 10;
    }

    function released(data) {
      return !data.accessPolicy.keys().hasAny(['releaseOn'])
        || !isoReady(data.accessPolicy.releaseOn)
        || request.time >= timestamp.date(
             int(data.accessPolicy.releaseOn[0:4]),
             int(data.accessPolicy.releaseOn[5:7]),
             int(data.accessPolicy.releaseOn[8:10]));
    }

    function beforeExpiry(data) {
      return !data.accessPolicy.keys().hasAny(['expiresOn'])
        || !isoReady(data.accessPolicy.expiresOn)
        || request.time < timestamp.date(
             int(data.accessPolicy.expiresOn[0:4]),
             int(data.accessPolicy.expiresOn[5:7]),
             int(data.accessPolicy.expiresOn[8:10])) + duration.value(1, 'd');
    }

    function withinAccessDays(data, courseId) {
      return !data.accessPolicy.keys().hasAny(['accessDays'])
        || !(data.accessPolicy.accessDays is int)
        || data.accessPolicy.accessDays <= 0
        || !enrolledHere(courseId)
        || request.time < enrollmentStart(courseId) + duration.value(data.accessPolicy.accessDays + 1, 'd');
    }

    function trialOpen(data, courseId) {
      return !data.accessPolicy.keys().hasAny(['trialDays'])
        || !(data.accessPolicy.trialDays is int)
        || data.accessPolicy.trialDays <= 0
        || !enrolledHere(courseId)
        || get(/databases/$(database)/documents/courses/$(courseId)/enrollments/$(request.auth.uid)).data.get('trial', false) != true
        || request.time < enrollmentStart(courseId) + duration.value(data.accessPolicy.trialDays + 1, 'd');
    }

    function nonNegative(n) {
      return n > 0 ? n : 0;
    }

    function dripSteps(data, courseId, moduleId) {
      return data.accessPolicy.dripMode == 'unit'
        ? nonNegative(get(/databases/$(database)/documents/courses/$(courseId)/modules/$(moduleId)).data.get('order', 1) - 1)
        : nonNegative(resource.data.get('order', 1) - 1);
    }

    function dripOpen(data, courseId, moduleId) {
      return !data.accessPolicy.keys().hasAny(['dripMode'])
        || data.accessPolicy.dripMode == 'none'
        || !(data.accessPolicy.get('dripEveryDays', 0) is int)
        || data.accessPolicy.dripEveryDays <= 0
        || !enrolledHere(courseId)
        || request.time >= enrollmentStart(courseId) + duration.value(dripSteps(data, courseId, moduleId) * data.accessPolicy.dripEveryDays, 'd');
    }

    function scheduleOpen(data, courseId, moduleId) {
      return released(data) && beforeExpiry(data) && withinAccessDays(data, courseId) && trialOpen(data, courseId) && dripOpen(data, courseId, moduleId);
    }

    function seatsOpen(courseId) {
      let data = get(/databases/$(database)/documents/courses/$(courseId)).data;
      return !policyOn(data)
        || !data.accessPolicy.keys().hasAny(['seatLimit'])
        || !(data.accessPolicy.seatLimit is int)
        || data.accessPolicy.seatLimit <= 0
        || data.accessPolicy.get('seatsUsed', 0) < data.accessPolicy.seatLimit;
    }

    function seatsUnchanged() {
      return isAdmin()
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accessPolicy'])
        || !resource.data.keys().hasAny(['accessPolicy'])
        || !(resource.data.accessPolicy is map)
        || !resource.data.accessPolicy.keys().hasAny(['seatsUsed'])
        || (request.resource.data.keys().hasAny(['accessPolicy'])
            && request.resource.data.accessPolicy is map
            && request.resource.data.accessPolicy.keys().hasAny(['seatsUsed'])
            && request.resource.data.accessPolicy.seatsUsed == resource.data.accessPolicy.seatsUsed);
    }

    function seatIncrement(courseId) {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accessPolicy'])
        && resource.data.keys().hasAny(['accessPolicy'])
        && resource.data.accessPolicy is map
        && request.resource.data.accessPolicy is map
        && request.resource.data.accessPolicy.diff(resource.data.accessPolicy).affectedKeys().hasOnly(['seatsUsed'])
        && request.resource.data.accessPolicy.seatsUsed == resource.data.accessPolicy.get('seatsUsed', 0) + 1
        && (isTeacherOrAdmin()
            || (!exists(/databases/$(database)/documents/courses/$(courseId)/enrollments/$(request.auth.uid))
                && existsAfter(/databases/$(database)/documents/courses/$(courseId)/enrollments/$(request.auth.uid))));
    }

    function plusOne(field) {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && request.resource.data[field] is number
        && request.resource.data[field] == resource.data.get(field, 0) + 1;
    }

    function revenueIncrement(courseId) {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revenueTotal'])
        && request.resource.data.revenueTotal is number
        && !exists(/databases/$(database)/documents/courses/$(courseId)/purchases/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/courses/$(courseId)/purchases/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/courses/$(courseId)/purchases/$(request.auth.uid)).data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/courses/$(courseId)/purchases/$(request.auth.uid)).data.amount is number
        && getAfter(/databases/$(database)/documents/courses/$(courseId)/purchases/$(request.auth.uid)).data.amount > 0
        && request.resource.data.revenueTotal == resource.data.get('revenueTotal', 0) + getAfter(/databases/$(database)/documents/courses/$(courseId)/purchases/$(request.auth.uid)).data.amount;
    }

    function ownsCourse(courseId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/courses/$(courseId)).data.ownerId == request.auth.uid;
    }

    // Launch catalogue rows carry seedKey. Only a platform admin may create
    // or edit them. A teacher draft without seedKey is unchanged.
    function catalogueSeed(data) {
      return data.keys().hasAny(['seedKey'])
        && data.seedKey is string
        && data.seedKey.size() > 0;
    }

    // A public marketplace listing. Teachers may prepare one, but only an
    // admin may set the published public state. Editing a listing an admin
    // already approved is allowed when that state does not change.
    function marketplaceListing(data) {
      return data.status == 'published'
        && (
          data.get('isPublic', false) == true
          || (data.keys().hasAny(['accessPolicy'])
              && data.accessPolicy is map
              && data.accessPolicy.keys().hasAny(['include'])
              && data.accessPolicy.include is list
              && data.accessPolicy.include.hasAny(['marketplace']))
          || (data.keys().hasAny(['audiences'])
              && data.audiences is list
              && data.audiences.hasAny(['marketplace']))
        );
    }

    function teacherCourseUpdate() {
      return isTeacherOrAdmin()
        && resource.data.ownerId == request.auth.uid
        && incoming().ownerId == resource.data.ownerId
        && seatsUnchanged()
        && (
          !marketplaceListing(incoming())
          || marketplaceListing(resource.data)
        )
        && institutionCourseUpdateOk();
    }

    // An institution course stays private until a platform admin approves the marketplace
    // and any co-brand. Poket School remains the owner of the programme.
    function institutionCourseCreateOk() {
      return incoming().get('institutionId', '') == ''
        || (
          incoming().get('marketplaceApproved', false) == false
          && incoming().get('libraryApproved', false) == false
          && incoming().get('accessMode', 'subscription') == 'subscription'
          && incoming().get('publishScope', 'institution') == 'institution'
          && incoming().get('isPublic', false) == false
          && incoming().get('cobrand', {}).get('enabled', false) == false
        );
    }
    function institutionCourseUpdateOk() {
      return isAdmin()
        || incoming().get('institutionId', '') == ''
        || (
          incoming().get('marketplaceApproved', false) == resource.data.get('marketplaceApproved', false)
          && incoming().get('libraryApproved', false) == resource.data.get('libraryApproved', false)
          && incoming().get('accessMode', 'subscription') == resource.data.get('accessMode', 'subscription')
          && incoming().get('cobrand', {}).get('enabled', false) == resource.data.get('cobrand', {}).get('enabled', false)
          && incoming().get('cobrand', {}).get('partnerId', '') == resource.data.get('cobrand', {}).get('partnerId', '')
          && (
            resource.data.get('marketplaceApproved', false) == true
            || (
              incoming().get('publishScope', 'institution') == 'institution'
              && incoming().get('isPublic', false) == false
            )
          )
        );
    }

    // The institution admin opens the academy library. The public marketplace
    // and the access mode stay with the platform admin.
    function institutionLibraryReview() {
      return isInstitutionAdmin()
        && resource.data.get('institutionId', '') != ''
        && resource.data.get('institutionId', '') == myInstitution()
        && incoming().ownerId == resource.data.ownerId
        && incoming().get('marketplaceApproved', false) == resource.data.get('marketplaceApproved', false)
        && incoming().get('accessMode', 'subscription') == resource.data.get('accessMode', 'subscription')
        && incoming().get('isPublic', false) == false
        && incoming().get('publishScope', 'institution') == 'institution'
        && incoming().libraryApproved is bool
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['libraryApproved', 'libraryNote', 'libraryDecidedBy', 'libraryDecidedAt']);
    }

    function couponGrantCreate(courseId) {
      return isSignedIn()
        && incoming().kind == 'coupon'
        && incoming().active == true
        && incoming().userId == request.auth.uid
        && incoming().courseId == courseId
        && incoming().code is string
        && exists(/databases/$(database)/documents/coupon_codes/$(incoming().code))
        && get(/databases/$(database)/documents/coupon_codes/$(incoming().code)).data.active == true
        && get(/databases/$(database)/documents/coupon_codes/$(incoming().code)).data.discountPct >= 100
        && get(/databases/$(database)/documents/coupon_codes/$(incoming().code)).data.courseId == courseId
        && get(/databases/$(database)/documents/coupon_codes/$(incoming().code)).data.expiresAt == incoming().expiresOn
        && request.time < timestamp.date(
             int(incoming().expiresOn[0:4]),
             int(incoming().expiresOn[5:7]),
             int(incoming().expiresOn[8:10])) + duration.value(1, 'd');
    }

    // ── Courses ───────────────────────────────────────────────
    match /courses/{courseId} {
      // Published marketplace courses are browsable without an account —
      // the marketplace advertises "browse and buy without an account".
      // A course that sets `audiences` is listed only for those audiences.
      // Courses without the field keep the older signed-in read.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid)
        || (enrolledHere(courseId) && (!policyOn(resource.data) || !excludeHit(resource.data)))
        || (!policyOn(resource.data) && !audienceGated(resource.data) && !targetsGated(resource.data) && !scopeGated(resource.data) && (
             isSignedIn()
             || (resource.data.status == 'published' && resource.data.isPublic == true)
           ))
        || (!policyOn(resource.data) && !audienceGated(resource.data) && targetsGated(resource.data)
            && resource.data.status == 'published'
            && targetsHit(resource.data))
        || (!policyOn(resource.data) && !audienceGated(resource.data) && !targetsGated(resource.data) && scopeGated(resource.data)
            && resource.data.status == 'published'
            && scopeHit(resource.data))
        || (!policyOn(resource.data) && audienceGated(resource.data)
            && resource.data.status == 'published'
            && (
              resource.data.audiences.hasAny(['marketplace'])
              || (isSignedIn() && audienceHit(resource.data))
            ))
        || (policyOn(resource.data)
            && resource.data.status == 'published'
            && !excludeHit(resource.data)
            && includeHit(resource.data, courseId)
            && (
              (isSignedIn() && (enrolledHere(courseId) || targeted(resource.data)))
              || (!isSignedIn() && targetingEmpty(resource.data) && resource.data.accessPolicy.include.hasAny(['marketplace']))
            ));
      allow create: if isAdmin()
        || (isTeacherOrAdmin()
            && incoming().ownerId == request.auth.uid
            && !marketplaceListing(incoming())
            && !catalogueSeed(incoming())
            && institutionCourseCreateOk());
      // The owner may edit their course. Counters still move by one for
      // enrolment, views, completion, and revenue. An admin may edit any course.
      // Seed catalogue rows are admin-only, including counter bumps.
      allow update: if (isAdmin() && seatsUnchanged())
        || (
          !catalogueSeed(resource.data)
          && !catalogueSeed(incoming())
          && (
            teacherCourseUpdate()
            || institutionLibraryReview()
            || seatIncrement(courseId)
            || plusOne('enrollmentCount')
            || plusOne('viewCount')
            || plusOne('completionCount')
            || revenueIncrement(courseId)
          )
        );
      allow delete: if isAdmin()
        || (isTeacherOrAdmin()
            && resource.data.ownerId == request.auth.uid
            && !catalogueSeed(resource.data));

      match /enrollments/{studentId} {
        allow read: if isSignedIn();
        // Enrol yourself, or be enrolled by a teacher/admin. A seat limit
        // refuses a new self-enrolment once seatsUsed has reached it.
        allow create: if isAdmin()
          || (isTeacherOrAdmin() && ownsCourse(courseId))
          || (isUser(studentId) && seatsOpen(courseId));
        allow update: if isUser(studentId) || isAdmin() || (isTeacherOrAdmin() && ownsCourse(courseId));
        allow delete: if isUser(studentId) || isAdmin();
      }

      match /grants/{grantId} {
        allow read: if isTeacherOrAdmin()
          || isUser(grantId)
          || (isSignedIn() && request.auth.token.email is string && request.auth.token.email.lower() == grantId);
        allow create: if ((isAdmin() || (isTeacherOrAdmin() && ownsCourse(courseId)))
              && incoming().kind == 'user'
              && incoming().active is bool)
          || (grantId == request.auth.uid && couponGrantCreate(courseId));
        allow update: if (isAdmin() || (isTeacherOrAdmin() && ownsCourse(courseId)))
          && incoming().kind == 'user'
          && incoming().active is bool;
        allow delete: if isAdmin();
      }

      match /access_audit/{entryId} {
        allow read: if isAdmin() || (isTeacherOrAdmin() && ownsCourse(courseId));
        allow create: if (isAdmin() || (isTeacherOrAdmin() && ownsCourse(courseId)))
          && incoming().actorId == request.auth.uid
          && incoming().action is string
          && incoming().detail is string;
        allow update, delete: if false;
      }

      match /purchases/{userId} {
        allow read: if isAdmin() || isUser(userId);
        allow create: if isUser(userId)
          && incoming().userId == userId
          && incoming().amount is number
          && incoming().amount > 0
          && incoming().get('tender', 'card') != 'sparks';
        allow update, delete: if false;
      }

      match /reviews/{userId} {
        allow read: if isSignedIn()
          || get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published';
        allow create, update: if isUser(userId)
          && exists(/databases/$(database)/documents/courses/$(courseId)/enrollments/$(request.auth.uid))
          && incoming().rating is int
          && incoming().rating >= 1
          && incoming().rating <= 5
          && incoming().userId == request.auth.uid;
        allow delete: if isUser(userId) || isAdmin();
      }

      match /questions/{questionId} {
        allow read: if isAdmin()
          || (isTeacherOrAdmin() && ownsCourse(courseId))
          || enrolledHere(courseId);
        allow create: if isSignedIn()
          && incoming().authorId == request.auth.uid
          && incoming().text is string
          && incoming().text.size() > 0
          && incoming().text.size() < 2000
          && (enrolledHere(courseId) || ownsCourse(courseId));
        allow update: if isAdmin() || (isTeacherOrAdmin() && ownsCourse(courseId));
        allow delete: if isAdmin()
          || (isTeacherOrAdmin() && ownsCourse(courseId))
          || (isSignedIn() && resource.data.authorId == request.auth.uid);
      }

      match /modules/{moduleId} {
        // Chapter titles are public so the marketplace can show a course's
        // curriculum before signup, the way every course marketplace does.
        // Module documents hold titles and ordering only — no lesson content.
        allow read: if true;
        allow create, update: if isAdmin()
          || (isTeacherOrAdmin()
              && ownsCourse(courseId)
              && !catalogueSeed(get(/databases/$(database)/documents/courses/$(courseId)).data));
        allow delete: if isAdmin()
          || (isTeacherOrAdmin()
              && ownsCourse(courseId)
              && !catalogueSeed(get(/databases/$(database)/documents/courses/$(courseId)).data));

        match /lessons/{lessonId} {
          // Deliberately NOT public: lesson documents carry aiOutputs, the
          // full generated content the paywall exists to protect.
          // Audience-gated courses open the full lesson to enrolled learners
          // and to staff in that audience. Everyone else gets the free preview.
          allow read: if isAdmin()
            || (isSignedIn() && get(/databases/$(database)/documents/courses/$(courseId)).data.ownerId == request.auth.uid)
            || (!policyOn(get(/databases/$(database)/documents/courses/$(courseId)).data)
                && (
                  enrolledHere(courseId)
                  || (!audienceGated(get(/databases/$(database)/documents/courses/$(courseId)).data)
                      && !targetsGated(get(/databases/$(database)/documents/courses/$(courseId)).data)
                      && !scopeGated(get(/databases/$(database)/documents/courses/$(courseId)).data)
                      && isSignedIn())
                  || (isSignedIn()
                      && targetsGated(get(/databases/$(database)/documents/courses/$(courseId)).data)
                      && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
                      && targetsHit(get(/databases/$(database)/documents/courses/$(courseId)).data)
                      && (
                        isTeacherOrAdmin()
                        || resource.data.get('order', 999) <= get(/databases/$(database)/documents/courses/$(courseId)).data.get('freePreviewCount', 1)
                      ))
                  || (isSignedIn()
                      && !targetsGated(get(/databases/$(database)/documents/courses/$(courseId)).data)
                      && scopeGated(get(/databases/$(database)/documents/courses/$(courseId)).data)
                      && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
                      && scopeHit(get(/databases/$(database)/documents/courses/$(courseId)).data)
                      && (
                        isTeacherOrAdmin()
                        || resource.data.get('order', 999) <= get(/databases/$(database)/documents/courses/$(courseId)).data.get('freePreviewCount', 1)
                      ))
                  || (isSignedIn()
                      && audienceGated(get(/databases/$(database)/documents/courses/$(courseId)).data)
                      && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
                      && audienceHit(get(/databases/$(database)/documents/courses/$(courseId)).data)
                      && (
                        isTeacherOrAdmin()
                        || resource.data.get('order', 999) <= get(/databases/$(database)/documents/courses/$(courseId)).data.get('freePreviewCount', 1)
                      ))
                ))
            || (policyOn(get(/databases/$(database)/documents/courses/$(courseId)).data)
                && isSignedIn()
                && !excludeHit(get(/databases/$(database)/documents/courses/$(courseId)).data)
                && (
                  ((hasRole('teacher') || isInstitutionAdmin())
                    && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
                    && includeHit(get(/databases/$(database)/documents/courses/$(courseId)).data, courseId))
                  || (scheduleOpen(get(/databases/$(database)/documents/courses/$(courseId)).data, courseId, moduleId)
                      && (
                        enrolledHere(courseId)
                        || grantActive(courseId)
                        || (get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
                            && includeHit(get(/databases/$(database)/documents/courses/$(courseId)).data, courseId)
                            && get(/databases/$(database)/documents/courses/$(courseId)).data.accessPolicy.get('freePreviewCount', 0) is int
                            && resource.data.get('order', 999) <= get(/databases/$(database)/documents/courses/$(courseId)).data.accessPolicy.get('freePreviewCount', 0))
                      ))
                ));
          allow create, update: if isAdmin()
            || (isTeacherOrAdmin()
                && ownsCourse(courseId)
                && !catalogueSeed(get(/databases/$(database)/documents/courses/$(courseId)).data));
          allow delete: if isAdmin()
            || (isTeacherOrAdmin()
                && ownsCourse(courseId)
                && !catalogueSeed(get(/databases/$(database)/documents/courses/$(courseId)).data));
        }
      }

      // Review comments stay with the course. Students never read them.
      match /reviewComments/{commentId} {
        allow read: if isAdmin() || (isTeacherOrAdmin() && ownsCourse(courseId));
        allow create: if (isAdmin() || (isTeacherOrAdmin() && ownsCourse(courseId)))
          && incoming().authorId == request.auth.uid
          && incoming().lessonId is string
          && incoming().body is string
          && incoming().body.size() > 0
          && incoming().body.size() <= 2000;
        allow update, delete: if isAdmin()
          || (isSignedIn() && resource.data.authorId == request.auth.uid);
      }
    }

    // Shareable course preview. A guest may fetch one unexpired snapshot by
    // its token. Listing the collection is refused so unpublished courses
    // cannot be enumerated.
    match /coursePreviews/{token} {
      allow get: if resource.data.expiresAt is number
        && resource.data.expiresAt > request.time.toMillis();
      allow list: if false;
      allow create: if isTeacherOrAdmin()
        && incoming().token == token
        && incoming().courseId is string
        && incoming().createdBy == request.auth.uid
        && incoming().expiresAt is number
        && incoming().expiresAt > request.time.toMillis()
        && incoming().expiresAt <= request.time.toMillis() + duration.value(14, 'd');
      allow update: if false;
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    // ── Coupon codes ──────────────────────────────────────────
    match /coupon_codes/{code} {
      // Readable so a student can validate a code they were given.
      allow read: if isSignedIn();
      allow create: if isAdmin()
        || (isTeacherOrAdmin()
            && incoming().createdBy == request.auth.uid
            && incoming().courseId is string
            && ownsCourse(incoming().courseId)
            && incoming().code is string
            && incoming().code == code
            && incoming().discountPct is number
            && incoming().discountPct >= 1
            && incoming().discountPct <= 100);
      allow delete: if isAdmin()
        || (isSignedIn()
            && resource.data.createdBy == request.auth.uid
            && ownsCourse(resource.data.courseId));
      // A redeemer may only bump the counter by one and add themselves to the
      // redeemed list. The course owner may turn their own code on or off.
      allow update: if isAdmin()
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['usedCount', 'redeemedBy'])
            && request.resource.data.usedCount == resource.data.usedCount + 1
            && request.resource.data.redeemedBy.hasAll(resource.data.redeemedBy)
            && request.auth.uid in request.resource.data.redeemedBy)
        || (isSignedIn()
            && resource.data.createdBy == request.auth.uid
            && ownsCourse(resource.data.courseId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
            && incoming().active is bool);
    }

    // ── Coupon redemptions ────────────────────────────────────
    // A redemption is the record of a coupon grant. It lives here rather than
    // as a permission string on the profile because users cannot be trusted to
    // write their own permissions — the rule below re-reads the real coupon and
    // refuses anything that does not match it, so a forged redemption is
    // impossible even though the write comes from the client.
    match /coupon_redemptions/{redemptionId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isTeacherOrAdmin());
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && exists(/databases/$(database)/documents/coupon_codes/$(incoming().code))
        && get(/databases/$(database)/documents/coupon_codes/$(incoming().code)).data.active == true
        && get(/databases/$(database)/documents/coupon_codes/$(incoming().code)).data.discountPct >= 100
        && get(/databases/$(database)/documents/coupon_codes/$(incoming().code)).data.courseId == incoming().courseId
        && get(/databases/$(database)/documents/coupon_codes/$(incoming().code)).data.expiresAt == incoming().expiresAt
        && request.time < timestamp.date(
             int(incoming().expiresAt[0:4]),
             int(incoming().expiresAt[5:7]),
             int(incoming().expiresAt[8:10])) + duration.value(1, 'd');
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ── Institutions ──────────────────────────────────────────
    match /institutions/{institutionId} {
      // Readable while signed out so a white-label subdomain can resolve its
      // branding before anyone logs in.
      allow read: if true;
      allow create, delete: if isAdmin();
      // An institution admin may edit their own institution — branding,
      // subdomain — but not create or remove one, and not touch another's.
      allow update: if isAdmin()
        || (tenantStaff(institutionId)
            && sameText('status')
            && sameText('plan')
            && sameText('state')
            && sameBool('listedForSelfJoin')
            && sameText('parentInstitutionId')
            && incoming().get('isolateData', false) == resource.data.get('isolateData', false)
            && (planAllowsWhiteLabel() || (hidePoweredUnchanged() && customDomainUnchanged())));

      match /licences/{licenceId} {
        allow read: if isAdmin() || (isSignedIn() && myInstitution() == institutionId);
        allow create, update, delete: if isAdmin();
      }

      match /classes/{classId} {
        allow read: if isAdmin() || (isSignedIn() && myInstitution() == institutionId);
        allow create, update, delete: if isAdmin()
          || (isInstitutionAdmin() && myInstitution() == institutionId);
      }

      match /invites/{emailId} {
        allow read: if isAdmin()
          || (isInstitutionAdmin() && myInstitution() == institutionId)
          || (isSignedIn() && request.auth.token.email == emailId);
        allow create, update: if isAdmin()
          || (isInstitutionAdmin() && myInstitution() == institutionId && incoming().email == emailId);
        allow delete: if isAdmin() || (isInstitutionAdmin() && myInstitution() == institutionId);
      }

      match /members/{memberId} {
        allow read: if isAdmin()
          || isUser(memberId)
          || (isSignedIn() && myInstitution() == institutionId);
        allow create: if isAdmin()
          || (isInstitutionAdmin() && myInstitution() == institutionId)
          || (isUser(memberId)
              && exists(/databases/$(database)/documents/institutions/$(institutionId)/invites/$(request.auth.token.email)));
        allow update, delete: if isAdmin()
          || (isInstitutionAdmin() && myInstitution() == institutionId);
      }

      match /settings/{settingId} {
        allow read: if tenantReader(institutionId);
        allow create: if isAdmin()
          || (tenantStaff(institutionId)
              && incoming().get('seatCount', 0) == 0
              && incoming().get('amount', 0) == 0);
        allow update: if isAdmin()
          || (tenantStaff(institutionId)
              && sameNumber('seatCount')
              && sameNumber('seatsUsed')
              && sameNumber('amount')
              && sameText('currency')
              && sameText('licenceStartsOn')
              && sameText('licenceEndsOn')
              && sameText('renewalOn')
              && sameText('poNumber')
              && sameText('plan'));
        allow delete: if isAdmin();
      }

      match /audit/{eventId} {
        allow read: if tenantReader(institutionId);
        allow create: if tenantStaff(institutionId)
          && incoming().actorId == request.auth.uid
          && incoming().keys().hasAll(['actorId', 'action', 'target', 'at']);
        allow update, delete: if false;
      }

      match /catalogue/{itemId} {
        allow read: if tenantReader(institutionId);
        allow create, update, delete: if tenantStaff(institutionId);
      }

      match /compliance/{itemId} {
        allow read: if tenantReader(institutionId);
        allow create, update, delete: if tenantStaff(institutionId);
      }

      match /learning_paths/{pathId} {
        allow read: if tenantReader(institutionId);
        allow create, update, delete: if tenantStaff(institutionId);
      }

      match /skills/{skillId} {
        allow read: if tenantReader(institutionId);
        allow create, update, delete: if tenantStaff(institutionId);
      }

      match /webhooks/{hookId} {
        allow read: if tenantStaff(institutionId);
        allow create, update: if tenantStaff(institutionId)
          && !incoming().keys().hasAny(['secret', 'token', 'key']);
        allow delete: if tenantStaff(institutionId);
      }

      match /api_keys/{keyId} {
        allow read: if tenantStaff(institutionId);
        allow create: if tenantStaff(institutionId)
          && !incoming().keys().hasAny(['secret', 'token', 'key']);
        allow update, delete: if isAdmin() || (isInstitutionAdmin() && myInstitution() == institutionId);
      }

      match /invoices/{invoiceId} {
        allow read: if tenantReader(institutionId);
        allow create: if isAdmin()
          || (tenantStaff(institutionId) && incoming().status == 'requested');
        allow update, delete: if isAdmin();
      }

      match /pricing/{docId} {
        allow read: if isAdmin() || (isSignedIn() && myInstitution() == institutionId);
        allow write: if isAdmin();
      }

      // Import roster. Owner deploy only. Harry approves the deploy.
      // joinRoster remains the seat ledger and is not this collection.
      match /rosters/{rosterId} {
        allow read: if isAdmin()
          || (isInstitutionAdmin() && myInstitution() == institutionId)
          || (hasRole('teacher') && myInstitution() == institutionId)
          || (isSignedIn() && resource.data.matchedUid == request.auth.uid);
        allow create, update: if isAdmin()
          || (isInstitutionAdmin()
              && myInstitution() == institutionId
              && incoming().email is string
              && incoming().email.size() > 3
              && incoming().email.size() < 200
              && incoming().firstName is string
              && incoming().firstName.size() > 0
              && incoming().firstName.size() < 80
              && incoming().lastName is string
              && incoming().lastName.size() > 0
              && incoming().lastName.size() < 80
              && incoming().level is string
              && incoming().level.size() > 0
              && incoming().level.size() < 40
              && incoming().gender in ['male', 'female']
              && incoming().role in ['student', 'parent']
              && incoming().status in ['pending', 'matched', 'invited']
              && incoming().importedAt is string
              && incoming().importBatchId is string
              && incoming().importBatchId.size() > 0
              && incoming().importBatchId.size() < 80
              && (!incoming().keys().hasAny(['studentNumber']) || (incoming().studentNumber is string && incoming().studentNumber.size() < 40))
              && (!incoming().keys().hasAny(['classId']) || (incoming().classId is string && incoming().classId.size() < 80))
              && (!incoming().keys().hasAny(['matchedUid']) || (incoming().matchedUid is string && incoming().matchedUid.size() < 128))
              && incoming().keys().hasOnly([
                'email', 'studentNumber', 'firstName', 'lastName', 'level', 'classId',
                'gender', 'role', 'status', 'matchedUid', 'importedAt', 'importBatchId'
              ]));
        allow delete: if isAdmin() || (isInstitutionAdmin() && myInstitution() == institutionId);
      }

      // Career extras. Owner deploy only. The Admin SDK writes these.
      match /openings/{openingId} {
        allow read: if isAdmin()
          || (isInstitutionAdmin() && myInstitution() == institutionId)
          || (isSignedIn()
              && resource.data.status == 'published'
              && (resource.data.institutionId == myInstitution()
                  || resource.data.institutionId == userData().get('alumniOf', '')));
        allow write: if false;
      }

      match /campaigns/{campaignId} {
        allow read: if isAdmin()
          || (isSignedIn() && (myInstitution() == institutionId || userData().get('alumniOf', '') == institutionId));
        allow write: if false;
        match /gifts/{giftId} {
          allow read: if isAdmin()
            || (isInstitutionAdmin() && myInstitution() == institutionId)
            || (isSignedIn() && resource.data.uid == request.auth.uid);
          allow write: if false;
        }
      }

      match /reunions/{reunionId} {
        allow read: if isAdmin()
          || (isSignedIn() && (myInstitution() == institutionId || userData().get('alumniOf', '') == institutionId));
        allow write: if false;
        match /rsvps/{uid} {
          allow read: if isAdmin() || (isInstitutionAdmin() && myInstitution() == institutionId) || isUser(uid);
          allow write: if false;
        }
        match /album/{photoId} {
          allow read: if isSignedIn() && resource.data.visible == true
            && (myInstitution() == institutionId || userData().get('alumniOf', '') == institutionId || isAdmin());
          allow write: if false;
        }
        match /tickets/{uid} {
          allow read: if isAdmin() || isUser(uid) || (isInstitutionAdmin() && myInstitution() == institutionId);
          allow write: if false;
        }
      }

      match /talks/{talkId} {
        allow read: if isAdmin()
          || (isInstitutionAdmin() && myInstitution() == institutionId)
          || (isSignedIn() && resource.data.status == 'approved'
              && (myInstitution() == institutionId || userData().get('alumniOf', '') == institutionId))
          || (isSignedIn() && resource.data.alumniId == request.auth.uid);
        allow write: if false;
      }

      // A person asks to join. Only an activated, listed academy accepts the request.
      // The institution admin decides it. The requester cannot approve themselves.
      match /join_requests/{requestId} {
        allow read: if isAdmin()
          || (isInstitutionAdmin() && myInstitution() == institutionId)
          || (isSignedIn() && resource.data.userId == request.auth.uid);
        allow create: if isSignedIn()
          && requestId == request.auth.uid
          && incoming().userId == request.auth.uid
          && incoming().status == 'pending'
          && incoming().role in ['student', 'teacher', 'parent']
          && incoming().email is string
          && incoming().name is string
          && incoming().name.size() > 0
          && incoming().name.size() < 200
          && incoming().childEmails is list
          && incoming().childEmails.size() <= 10
          && incoming().createdAt is string
          && incoming().keys().hasOnly(['userId', 'role', 'email', 'name', 'status', 'childEmails', 'createdAt'])
          && exists(/databases/$(database)/documents/institutions/$(institutionId))
          && get(/databases/$(database)/documents/institutions/$(institutionId)).data.status == 'active'
          && get(/databases/$(database)/documents/institutions/$(institutionId)).data.listedForSelfJoin == true;
        allow update: if isAdmin()
          || (isInstitutionAdmin()
              && myInstitution() == institutionId
              && resource.data.status == 'pending'
              && incoming().status in ['approved', 'rejected']
              && incoming().userId == resource.data.userId
              && incoming().role == resource.data.role
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['status', 'level', 'classIds', 'courseIds', 'decidedBy', 'decidedAt']));
        allow delete: if isAdmin();
      }

      match /sparks_pool/{docId} {
        allow read: if tenantReader(institutionId);
        allow write: if isAdmin();
      }

      match /sparks_allocations/{allocationId} {
        allow read: if isAdmin()
          || (isInstitutionAdmin() && myInstitution() == institutionId)
          || (isSignedIn() && resource.data.subjectId == request.auth.uid)
          || (hasRole('teacher')
              && myInstitution() == institutionId
              && resource.data.get('classId', '') != ''
              && userData().get('cohortIds', []).hasAny([resource.data.classId]))
          || linkedTo(resource.data.subjectId);
        allow create, update: if isAdmin()
          || (isInstitutionAdmin()
              && myInstitution() == institutionId
              && incoming().subjectId is string
              && incoming().amount is int
              && incoming().amount >= 0
              && incoming().amount <= 20000
              && incoming().keys().hasOnly(['subjectId', 'amount', 'classId', 'note', 'at']));
        allow delete: if isAdmin() || (isInstitutionAdmin() && myInstitution() == institutionId);
      }

      match /billing/{docId} {
        allow read: if tenantReader(institutionId);
        allow write: if isAdmin();
      }

      match /notifications/{noticeId} {
        allow read: if tenantReader(institutionId);
        allow create: if tenantStaff(institutionId)
          && incoming().keys().hasOnly(['kind', 'title', 'body', 'audience', 'at'])
          && incoming().kind is string
          && incoming().title is string
          && incoming().body is string;
        allow update, delete: if isAdmin();
      }

      match /sparks_guard/{docId} {
        allow read: if tenantReader(institutionId);
        allow write: if isAdmin()
          || (isInstitutionAdmin() && myInstitution() == institutionId);
      }
    }

    match /subdomain_redirects/{slug} {
      allow read: if true;
      allow create, update: if isAdmin()
        || (isInstitutionAdmin()
            && incoming().institutionId == myInstitution()
            && incoming().subdomain is string
            && incoming().institutionId is string);
      allow delete: if isAdmin()
        || (isInstitutionAdmin() && resource.data.institutionId == myInstitution());
    }

    match /join_codes/{code} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
        || (isInstitutionAdmin() && incoming().institutionId == myInstitution());
      allow delete: if isAdmin();
    }

    match /demo_leads/{leadId} {
      allow create: if incoming().keys().hasOnly(['name', 'email', 'organisation', 'country', 'type', 'seats', 'message', 'status', 'createdAt'])
        && incoming().status == 'new'
        && incoming().name is string
        && incoming().name.size() > 1
        && incoming().name.size() < 200
        && incoming().email is string
        && incoming().email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && incoming().organisation is string
        && incoming().organisation.size() > 1
        && incoming().organisation.size() < 200
        && incoming().country is string
        && incoming().country.size() == 2
        && incoming().type in ['school', 'university', 'corporate', 'government']
        && incoming().seats is int
        && incoming().seats >= 1
        && incoming().seats <= 100000
        && incoming().message is string
        && incoming().message.size() < 2000
        && incoming().createdAt is timestamp;
      allow read, update, delete: if isAdmin();
    }

    match /admin_audit/{eventId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && incoming().actorId == request.auth.uid;
      allow update, delete: if false;
    }

    match /sparks_config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /core_programmes/{programmeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /partner_orgs/{orgId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /partner_revenue/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && incoming().partnerId is string
        && incoming().amount is number
        && incoming().amount >= 0
        && incoming().channel in ['enterprise_invoice', 'individual'];
      allow update, delete: if false;
    }

    match /subscriber_billing/{userId} {
      allow read: if isAdmin() || isUser(userId);
      allow write: if isAdmin();
    }

    // One wallet. The owner and an admin can read it. The balance moves from
    // the server, or from an admin. Sparks are not a tender. Ledger rows are
    // server-only.
    match /wallets/{userId} {
      allow read: if isAdmin() || isUser(userId);
      allow write: if isAdmin();
      match /ledger/{entryId} { allow read, write: if false; }
    }

    match /wallet_entries/{entryId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
        && incoming().userId is string
        && incoming().kind in ['topup', 'purchase', 'gift_out', 'gift_in', 'refund']
        && incoming().amount is number
        && incoming().amount > 0
        && incoming().get('tender', 'card') != 'sparks';
      allow update, delete: if false;
    }

    match /consents/{consentId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().kind in ['pdpa', 'terms', 'privacy', 'parental']
        && incoming().accepted == true
        && incoming().version is string
        && incoming().at is string;
      allow update, delete: if false;
    }

    match /data_requests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().kind in ['export', 'delete']
        && incoming().status == 'pending';
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── Badges ────────────────────────────────────────────────
    match /badges/{badgeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Adult-only direct messages. The mobile app reads this collection.
    // Minors use class channels, never this inbox. fromId must be the caller
    // so a student cannot forge a teacher.
    match /messages/{messageId} {
      allow read: if isSignedIn() && (
        resource.data.fromId == request.auth.uid ||
        resource.data.toId == request.auth.uid
      ) && callerAgeTier() == 'adult'
        && userAgeTier(resource.data.fromId) == 'adult'
        && userAgeTier(resource.data.toId) == 'adult';
      allow create: if isSignedIn() && dmCreateOk();
      allow update: if isSignedIn()
        && resource.data.toId == request.auth.uid
        && callerAgeTier() == 'adult'
        && userAgeTier(resource.data.fromId) == 'adult'
        && userAgeTier(resource.data.toId) == 'adult'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin();
    }

    // ── Lesson Notes ─────────────────────────────────────────
    match /lesson_notes/{noteId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
    }

    // ── Submissions ───────────────────────────────────────────
    match /submissions/{submissionId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid || isTeacherOrAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isTeacherOrAdmin();
      allow delete: if isAdmin();
    }

    // ── Live Classes ──────────────────────────────────────────
    match /live_classes/{classId} {
      allow read: if isSignedIn();
      allow create, update: if isTeacherOrAdmin();
      allow delete: if isAdmin();
    }

    // ── Exams ─────────────────────────────────────────────────
    match /exams/{examId} {
      allow read: if isSignedIn();
      allow create, update: if isTeacherOrAdmin();
      allow delete: if isAdmin();
    }

    // ── Exam Submissions ──────────────────────────────────────
    match /exam_submissions/{submissionId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid || isTeacherOrAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isTeacherOrAdmin();
      allow delete: if isAdmin();
    }

    // ── Assignments ───────────────────────────────────────────
    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create, update: if isTeacherOrAdmin();
      allow delete: if isAdmin();
    }

    // ── Announcements ─────────────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create, update: if isTeacherOrAdmin() || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Calendar Events ───────────────────────────────────────
    match /calendar_events/{eventId} {
      allow read: if isSignedIn();
      allow create, update: if isTeacherOrAdmin();
      allow delete: if isTeacherOrAdmin();
    }

    // ── Resources ─────────────────────────────────────────────
    match /resources/{resourceId} {
      allow read: if isSignedIn();
      allow create, update: if isTeacherOrAdmin();
      allow delete: if isTeacherOrAdmin();
    }

    // ── Support Tickets ───────────────────────────────────────
    match /support_tickets/{ticketId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isTeacherOrAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isTeacherOrAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── AI Generations (user library) ─────────────────────────
    match /users/{userId}/ai_generations/{genId} {
      allow read, create: if isUser(userId);
      allow delete: if isUser(userId) || isAdmin();
    }

    // ── Study tools: exam preps, maths sessions, exam packs ────
    // Private to the student. A linked parent can read progress (never
    // write it); nobody else can see it.
    function isParentOf(uid) {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('childIds', []).hasAny([uid]);
    }

    // Assigned goals. daily_goals stays the student's own list.
    // source self matches older student. source et_ai matches older ai.
    // Parent and teacher read (private, parentVisibility, shareWithTeachers,
    // teacherIds) is added on PR #144. This match is not deployed.
    // source=teacher goals are deleted only by the teacher who assigned them.
    // A student cannot delete a teacher or institution goal.
    match /users/{userId}/goals/{goalId} {
      allow read: if isSignedIn() && (
        isUser(userId) || isParentOf(userId) || isTeacherOrAdmin() || isAdmin()
      );
      allow create: if isSignedIn() && incoming().studentId == userId && (
        (isUser(userId) && incoming().source == 'student' && incoming().assignedBy == request.auth.uid)
        || (isTeacherOrAdmin() && incoming().source == 'teacher' && incoming().assignedBy == request.auth.uid)
        || ((isInstitutionAdmin() || isAdmin()) && incoming().source == 'institution')
        || isAdmin()
      );
      allow update: if isAdmin()
        || (isUser(userId) && resource.data.source == 'student')
        || (isTeacherOrAdmin() && resource.data.source == 'teacher' && resource.data.assignedBy == request.auth.uid)
        || (isInstitutionAdmin() && (resource.data.source == 'institution' || resource.data.source == 'teacher'));
      allow delete: if isAdmin()
        || (resource.data.source == 'student' && isUser(userId))
        || (resource.data.source == 'teacher' && resource.data.assignedBy == request.auth.uid)
        || (resource.data.source == 'institution' && (isInstitutionAdmin() || isAdmin()));
    }

    match /school_classes/{classId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
        || (isInstitutionAdmin() && incoming().institutionId == myInstitution())
        || (isTeacherOrAdmin()
            && incoming().ownerTeacherId == request.auth.uid
            && (incoming().get('institutionId', '') == '' || incoming().institutionId == myInstitution()));
      allow delete: if isAdmin()
        || (isInstitutionAdmin() && resource.data.institutionId == myInstitution())
        || (isTeacherOrAdmin() && resource.data.ownerTeacherId == request.auth.uid);
    }

    match /school_enrolments/{enrolmentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacherOrAdmin() || isAdmin();
    }

    match /school_assessments/{assessmentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacherOrAdmin() || isAdmin();
    }

    match /school_marks/{markId} {
      allow read: if isSignedIn();
      allow create, update: if isTeacherOrAdmin() || isAdmin();
      allow delete: if isAdmin();
    }

    match /school_attendance/{rowId} {
      allow read: if isSignedIn();
      allow create, update: if isTeacherOrAdmin() || isAdmin();
      allow delete: if isAdmin();
    }

    match /users/{userId}/exam_preps/{prepId} {
      allow read: if isUser(userId) || isParentOf(userId) || isAdmin();
      allow create: if isUser(userId) && incoming().ownerId == userId;
      allow update: if isUser(userId) && incoming().ownerId == userId;
      allow delete: if isUser(userId);

      // Material, cached lessons and quizzes, exam attempts.
      match /{sub=**} {
        allow read: if isUser(userId) || isParentOf(userId) || isAdmin();
        allow write: if isUser(userId);
      }
    }

    match /users/{userId}/math_sessions/{sessionId} {
      allow read: if isUser(userId) || isParentOf(userId) || isAdmin();
      allow write: if isUser(userId);
    }

    match /users/{userId}/pack_progress/{packId} {
      allow read: if isUser(userId) || isParentOf(userId) || isAdmin();
      allow write: if isUser(userId);

      // Cached question sets for each topic.
      match /{sub=**} {
        allow read: if isUser(userId) || isParentOf(userId) || isAdmin();
        allow write: if isUser(userId);
      }
    }

    // Sticky notes. Private to the owner. Sharing is written by the server.
    function noteShape() {
      return incoming().text is string
        && incoming().text.size() <= 2000
        && incoming().colour in ['cyan', 'sky', 'coral', 'success', 'lilac', 'white']
        && incoming().pinned is bool
        && incoming().order is number
        && incoming().board is string
        && incoming().board.size() > 0
        && incoming().board.size() <= 80
        && incoming().linkedTo is map
        && incoming().linkedTo.type in ['lesson', 'course', 'assignment', 'exam', 'none']
        && incoming().linkedTo.id is string
        && incoming().createdAt is number
        && incoming().updatedAt is number;
    }

    match /users/{userId}/notes/{noteId} {
      allow read: if isUser(userId);
      allow create: if isUser(userId)
        && noteShape()
        && !incoming().keys().hasAny(['share'])
        && (!incoming().keys().hasAny(['remindedAt']) || incoming().remindedAt == 0);
      allow update: if isUser(userId)
        && noteShape()
        && incoming().get('share', null) == resource.data.get('share', null)
        && (
          incoming().get('remindedAt', 0) == 0
          || incoming().get('remindedAt', 0) == resource.data.get('remindedAt', 0)
        );
      allow delete: if false;
    }

    match /note_shares/{shareId} {
      allow read: if isSignedIn()
        && resource.data.status == 'live'
        && (
          resource.data.ownerId == request.auth.uid
          || canSeeSpaceData(spaceDoc(resource.data.spaceId))
        );
      allow write: if false;
    }

    // A classmate can read a shared plan's content to start their own copy;
    // only the person who shared it can change or withdraw it.
    match /shared_preps/{shareId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // "Something's wrong with this answer" reports, reviewed by admins.
    match /ai_reports/{reportId} {
      allow create: if isSignedIn() && incoming().uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // ── Behaviour Records ─────────────────────────────────────
    match /behaviour_records/{recordId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.studentId == request.auth.uid
        || linkedTo(resource.data.studentId)
        || resource.data.recordedBy == request.auth.uid
        || resource.data.get('teacherIds', []).hasAny([request.auth.uid])
        || (isInstitutionAdmin()
            && resource.data.get('institutionId', '') != ''
            && resource.data.get('institutionId', '') == myInstitution())
      );
      allow create: if isTeacherOrAdmin() && incoming().recordedBy == request.auth.uid;
      allow update: if isTeacherOrAdmin() && resource.data.recordedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ── Attendance Records ────────────────────────────────────
    // Reads stay with the teacher who marked the row, the student, a linked
    // parent, or the institution admin for that school. A signed-in stranger
    // cannot list the register.
    function attendanceReadable(data) {
      return isAdmin()
        || data.get('teacherId', '') == request.auth.uid
        || data.get('studentId', '') == request.auth.uid
        || data.get('studentIds', []).hasAny([request.auth.uid])
        || data.get('parentIds', []).hasAny([request.auth.uid])
        || linkedTo(data.get('studentId', ''))
        || (isInstitutionAdmin()
            && data.get('institutionId', '') is string
            && data.get('institutionId', '') != ''
            && data.get('institutionId', '') == myInstitution());
    }
    match /attendance/{recordId} {
      allow read: if isSignedIn() && attendanceReadable(resource.data);
      allow create, update: if isTeacherOrAdmin();
      allow delete: if isAdmin();
    }

    // ── Invoices / Billing ────────────────────────────────────
    match /invoices/{invoiceId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid
        || isTeacherOrAdmin()
        || isParentOf(resource.data.studentId)
      );
      // A student buying a course raises their own invoice. Without this the
      // purchase completed with no billing record at all, because the client
      // swallowed the permission error. They may only raise an unpaid invoice
      // for themselves — marking one paid stays with teachers and admins.
      allow create: if isTeacherOrAdmin()
        || (isSignedIn()
            && incoming().studentId == request.auth.uid
            && incoming().status in ['sent', 'draft']
            && userData().get('institutionId', '') == '');
      allow update: if isTeacherOrAdmin();
      allow delete: if isAdmin();
    }

    // ── Report Cards ──────────────────────────────────────────
    match /report_cards/{cardId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.studentId == request.auth.uid
        || resource.data.get('teacherId', '') == request.auth.uid
        || resource.data.get('teacherIds', []).hasAny([request.auth.uid])
        || linkedTo(resource.data.studentId)
        || (hasRole('teacher')
            && resource.data.get('classId', '') != ''
            && userData().get('cohortIds', []).hasAny([resource.data.classId]))
        || (isInstitutionAdmin()
            && resource.data.get('institutionId', '') != ''
            && resource.data.get('institutionId', '') == myInstitution())
      );
      allow create: if isTeacherOrAdmin();
      allow update: if isTeacherOrAdmin()
        || (linkedTo(resource.data.studentId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledgement'])
            && request.resource.data.acknowledgement.status == 'acknowledged'
            && request.resource.data.acknowledgement.parentId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── Integrity Reports ─────────────────────────────────────
    match /integrity_reports/{reportId} {
      allow read: if isTeacherOrAdmin()
        || (isSignedIn() && resource.data.studentId == request.auth.uid)
        || linkedTo(resource.data.studentId);
      allow create, update: if isTeacherOrAdmin();
      allow delete: if isAdmin();
    }

    // ── Certificates ──────────────────────────────────────────
    // Public get so /verify/{id} works without a login. The Admin SDK writes
    // these after it has checked published-lesson completion. A signed-in
    // teacher or student must not mint one from the browser.
    match /skill_maps/{mapId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /opportunities/{opportunityId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /users/{userId}/proven_skills/{skillId} {
      allow read: if isUser(userId) || linkedTo(userId) || isAdmin();
      allow write: if false;
    }

    match /users/{userId}/endorsements/{endorsementId} {
      allow read: if isUser(userId) || linkedTo(userId) || isTeacherOrAdmin() || isAdmin();
      allow write: if false;
    }

    match /users/{userId}/parent_bridge/{docId} {
      allow read: if isUser(userId) || linkedTo(userId) || isAdmin();
      allow write: if false;
    }

    match /users/{userId}/career/{docId} {
      allow read: if isUser(userId) || isAdmin();
      allow write: if false;
    }

    match /users/{userId}/applications/{applicationId} {
      allow read: if isUser(userId) || isAdmin();
      allow write: if false;
    }

    match /certificates/{certId} {
      allow get: if true;
      allow list: if isSignedIn() && (
        resource.data.studentId == request.auth.uid
        || isTeacherOrAdmin()
        || linkedTo(resource.data.studentId)
      );
      allow create, update, delete: if false;
    }

    // Server-written gamification and house boards. Owner deploy only.
    match /gamification/{userId} {
      allow read: if isSignedIn() && (isUser(userId) || isAdmin() || linkedTo(userId));
      allow write: if false;
    }

    match /gamification_config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /leaderboard_entries/{entryId} {
      allow read: if resource.data.shareBoard == true;
      allow write: if false;
    }

    match /certificate_keys/{keyId} {
      allow read, write: if false;
    }

    // ── Tasks ─────────────────────────────────────────────────
    match /tasks/{taskId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.assignedTo == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        isTeacherOrAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isTeacherOrAdmin()
      );
    }

    // ── Daily Goals (student accountability) ──────────────────
    match /daily_goals/{goalId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid
        || isAdmin()
        || linkedTo(resource.data.studentId)
        || teacherMayReadGoal()
      );
      allow create: if isSignedIn()
        && incoming().studentId == request.auth.uid
        && !incoming().keys().hasAny(['sparksAwarded', 'cosignedBy', 'cosignedAt', 'excusedBy', 'excuseReason']);
      allow update: if isAdmin() || studentGoalUpdate() || parentGoalUpdate();
      allow delete: if isSignedIn() && (
        resource.data.studentId == request.auth.uid || isAdmin()
      );
    }

    // ── Grades ────────────────────────────────────────────────
    match /grades/{gradeId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid
        || isTeacherOrAdmin()
        || linkedTo(resource.data.studentId)
      );
      allow create, update: if isTeacherOrAdmin();
      allow delete: if isAdmin();
    }

    // ── Grade weights (doc id = courseId) ─────────────────────
    match /grade_weights/{courseId} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrAdmin();
    }

    // ── Assignment Submissions ────────────────────────────────
    match /assignment_submissions/{submissionId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid || isTeacherOrAdmin()
      );
      allow create: if isSignedIn() && incoming().studentId == request.auth.uid;
      allow update: if isTeacherOrAdmin();
      allow delete: if isAdmin();
    }

    // ── Attendance Records ────────────────────────────────────
    match /attendance_records/{recordId} {
      allow read: if isSignedIn() && attendanceReadable(resource.data);
      allow create, update: if isTeacherOrAdmin();
      allow delete: if isAdmin();
    }

    match /absence_notes/{noteId} {
      allow read: if isSignedIn() && (
        isTeacherOrAdmin()
        || resource.data.studentId == request.auth.uid
        || resource.data.parentId == request.auth.uid
        || linkedTo(resource.data.studentId)
      );
      allow create: if isSignedIn()
        && incoming().parentId == request.auth.uid
        && linkedTo(incoming().studentId)
        && incoming().status == 'submitted'
        && incoming().dateKey is string
        && incoming().reason is string
        && incoming().reason.size() > 0
        && incoming().reason.size() <= 500
        && incoming().keys().hasOnly(['studentId', 'parentId', 'dateKey', 'reason', 'courseId', 'status', 'createdAt']);
      allow update: if isTeacherOrAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
      allow delete: if isAdmin();
    }

    match /report_exports/{exportId} {
      allow read: if isSignedIn() && (resource.data.actorId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && incoming().actorId == request.auth.uid
        && incoming().format in ['pdf', 'csv', 'xlsx']
        && incoming().metricIds is list
        && incoming().role is string
        && incoming().scopeId is string
        && incoming().at is string
        && incoming().keys().hasOnly(['actorId', 'role', 'format', 'metricIds', 'scopeId', 'at']);
      allow update, delete: if false;
    }

    // ── Notifications ─────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }

    // ── Chat Messages (live class rooms) ──────────────────────
    match /chat_messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ── Teacher notification signups (emails subcollection) ───
    match /teacher_notifications/{teacherId}/emails/{emailId} {
      allow create: if isSignedIn();
      allow read: if isTeacherOrAdmin();
      allow update, delete: if isAdmin();
    }

    // ── Parent links and invites ──────────────────────────────
    // Email requests stay pending until the student approves. An invite is
    // accepted by the student, who then writes the approved link document.
    match /parent_links/{linkId} {
      allow read: if isSignedIn() && (
        resource.data.parentId == request.auth.uid
        || resource.data.studentId == request.auth.uid
        || isAdmin()
      );
      allow create: if isSignedIn() && (
        (hasRole('parent')
          && incoming().parentId == request.auth.uid
          && incoming().status == 'pending'
          && incoming().studentId is string
          && incoming().studentId != request.auth.uid
          && linkId == incoming().parentId + '_' + incoming().studentId
          && incoming().studentEmail is string
          && incoming().keys().hasOnly(['parentId', 'parentName', 'parentEmail', 'studentId', 'studentEmail', 'status', 'createdAt'])
          && get(/databases/$(database)/documents/users/$(incoming().studentId)).data.role == 'student')
        || (incoming().status == 'approved'
          && incoming().studentId == request.auth.uid
          && incoming().parentId is string
          && linkId == incoming().parentId + '_' + request.auth.uid
          && incoming().inviteCode is string
          && exists(/databases/$(database)/documents/parent_invites/$(incoming().inviteCode))
          && get(/databases/$(database)/documents/parent_invites/$(incoming().inviteCode)).data.parentId == incoming().parentId
          && get(/databases/$(database)/documents/parent_invites/$(incoming().inviteCode)).data.status == 'accepted'
          && get(/databases/$(database)/documents/parent_invites/$(incoming().inviteCode)).data.childId == request.auth.uid
          && incoming().keys().hasOnly(['parentId', 'parentName', 'studentId', 'status', 'inviteCode', 'createdAt']))
      );
      allow update: if isSignedIn()
        && resource.data.studentId == request.auth.uid
        && resource.data.status == 'pending'
        && incoming().status in ['approved', 'rejected']
        && incoming().studentId == resource.data.studentId
        && incoming().parentId == resource.data.parentId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedAt']);
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.parentId == request.auth.uid && resource.data.status == 'pending');
    }

    match /parent_invites/{code} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.parentId == request.auth.uid;
      allow create: if isSignedIn()
        && hasRole('parent')
        && incoming().parentId == request.auth.uid
        && incoming().status == 'open'
        && incoming().code == code
        && code.size() >= 8
        && incoming().keys().hasOnly(['parentId', 'parentName', 'code', 'status', 'createdAt']);
      allow update: if isSignedIn() && (
        (resource.data.parentId == request.auth.uid
          && resource.data.status == 'open'
          && incoming().status == 'revoked'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        || (resource.data.status == 'open'
          && incoming().status == 'accepted'
          && incoming().childId == request.auth.uid
          && incoming().parentId == resource.data.parentId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'childId', 'acceptedAt']))
      );
      allow delete: if isAdmin();
    }

    // A child asks, and the linked parent approves, before the purchase.
    match /purchase_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid
        || resource.data.parentId == request.auth.uid
        || isAdmin()
      );
      allow create: if isSignedIn()
        && incoming().studentId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().parentId is string
        && get(/databases/$(database)/documents/users/$(incoming().parentId)).data.get('childIds', []).hasAny([request.auth.uid])
        && incoming().keys().hasOnly(['studentId', 'parentId', 'title', 'amount', 'currency', 'status', 'createdAt', 'kind', 'itemId']);
      allow update: if isSignedIn()
        && resource.data.parentId == request.auth.uid
        && resource.data.status == 'pending'
        && incoming().status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt']);
      allow delete: if false;
    }

    // ── Parent verification requests ──────────────────────────
    match /parent_verifications/{verificationId} {
      allow create: if isSignedIn();
      allow read, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Launch catalogue documents. Clients other than a platform admin cannot write them.
    match /seed/{docId} {
      allow read, write: if isAdmin();
    }

    // ── Platform settings (admin console) ─────────────────────
    // feature_flags is read by every signed-in client. Payments and other
    // settings are admin-only. Writes are admin-only for every document.
    match /platform_settings/{docId} {
      allow get: if isSignedIn() && (docId == 'feature_flags' || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
      // Emergency numbers live at platform_settings/emergency_numbers/catalog/{countryCode}.
      // The editor is the API. Clients, including admins, cannot write the catalog.
      match /catalog/{countryCode} {
        allow read: if true;
        allow write: if false;
      }
    }

    // ── Public pricing (admin-managed). Deploy with the rest of these rules.
    match /pricing_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Who changed a price. Clients may append a row for themselves; nobody edits history.
    match /pricing_audit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && incoming().actorId == request.auth.uid;
      allow update, delete: if false;
    }

    // Super-admin institution volume tiers. Signed-in academy staff can read the list.
    match /institution_pricing/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /institution_pricing_audit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && incoming().actorId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── User sessions (device history) ────────────────────────
    match /user_sessions/{sessionId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Shared image library. Storage holds the bytes at media/{scopeId}/{name}.
    // This document is the metadata a course or a book can list again.
    match /media_assets/{assetId} {
      allow read: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid || isTeacherOrAdmin()
      );
      allow create: if isSignedIn()
        && incoming().ownerId == request.auth.uid
        && incoming().scopeId is string
        && incoming().src is string
        && incoming().alt is string;
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && incoming().ownerId == request.auth.uid;
      allow delete: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid || isAdmin()
      );
    }

    match /admin_invites/{emailId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && callerIsSuper()
        || (isAdmin() && incoming().staffRole != 'super_admin');
      allow delete: if callerIsSuper();
    }

    match /platform_signals/{signalId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Device push tokens (Poketschool app + web) ───────────
    // Clients may register and remove their own device. They may not read
    // or list the collection; the Admin SDK delivers pushes.
    // Delete has no new document, so the new userId is checked only when
    // request.resource exists.
    match /deviceTokens/{deviceId} {
      allow read: if false;

      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && incoming().userId == request.auth.uid;

      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && (request.resource == null || request.resource.data.userId == request.auth.uid);
    }

    // Poket Reads. Library, reading sessions, and leaderboard writes stay
    // denied. A teacher may write a book they own. The Admin SDK bypasses
    // these rules.
    match /books/{bookId} {
      allow read: if isAdmin()
        || (isTeacherOrAdmin() && resource.data.ownerId == request.auth.uid)
        || (resource.data.status == 'published' && (
          (targetsGated(resource.data) && targetsHit(resource.data))
          || (!targetsGated(resource.data) && (
            resource.data.get('allocateMarketplace', false) == true
            || resource.data.get('allocateLibrary', false) == true
          ))
        ));
      allow create: if isAdmin()
        || (isTeacherOrAdmin()
            && incoming().ownerId == request.auth.uid
            && incoming().id == bookId);
      allow update: if isAdmin()
        || (isTeacherOrAdmin()
            && resource.data.ownerId == request.auth.uid
            && incoming().ownerId == request.auth.uid);
      allow delete: if isAdmin()
        || (isTeacherOrAdmin() && resource.data.ownerId == request.auth.uid);
      match /chapters/{chapterId} {
        allow read: if isAdmin()
          || (isTeacherOrAdmin()
              && get(/databases/$(database)/documents/books/$(bookId)).data.ownerId == request.auth.uid)
          || (isSignedIn() && get(/databases/$(database)/documents/books/$(bookId)).data.status == 'published')
          || (resource.data.preview == true
              && get(/databases/$(database)/documents/books/$(bookId)).data.status == 'published');
        allow write: if isAdmin()
          || (isTeacherOrAdmin()
              && get(/databases/$(database)/documents/books/$(bookId)).data.ownerId == request.auth.uid);
      }
      match /languageVersions/{lang} {
        allow read: if isAdmin() || resource.data.status == 'approved';
        allow write: if isAdmin();
      }
    }
    match /library/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /readingSessions/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /leaderboards/{id} {
      allow read: if isSignedIn() && resource.data.optIn == true && resource.data.hidden != true;
      allow write: if false;
    }

    // ── Community feed (shared with the Expo app) ─────────────
    // Collections: spaces, posts, comments, reactions, follows, reports,
    // moderation_queue, and messages (adult DMs, above).
    match /community_profiles/{userId} {
      allow read: if isSignedIn() && role() != 'parent' && resource.data.ageTier == callerAgeTier();
      allow create: if isUser(userId)
        && incoming().ageTier == callerAgeTier()
        && incoming().ageTier in ['under13', 'teen', 'adult'];
      allow update: if isUser(userId)
        && request.resource.data.ageTier == resource.data.ageTier
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'bio', 'isPublic', 'adultDmOptIn', 'updatedAt']);
      allow delete: if isAdmin();
    }

    match /spaces/{spaceId} {
      allow read: if isSignedIn() && canSeeSpaceData(resource.data);
      allow create, update, delete: if false;
    }

    match /posts/{postId} {
      allow read: if isSignedIn() && (
        resource.data.authorId == request.auth.uid
        || (resource.data.moderation == 'allow' && canSeeSpaceData(spaceDoc(resource.data.spaceId)))
      );
      allow create, update, delete: if false;
    }

    match /comments/{commentId} {
      allow read: if isSignedIn() && (
        resource.data.authorId == request.auth.uid
        || (resource.data.moderation == 'allow' && canSeeSpaceData(spaceDoc(resource.data.spaceId)))
      );
      allow create, update, delete: if false;
    }

    match /reactions/{reactionId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || canSeeSpaceData(spaceDoc(get(/databases/$(database)/documents/posts/$(resource.data.postId)).data.spaceId))
      );
      allow create, update, delete: if false;
    }

    match /follows/{followId} {
      allow read: if isSignedIn()
        && role() != 'parent'
        && (resource.data.followerId == request.auth.uid || resource.data.targetId == request.auth.uid)
        && resource.data.followerAgeTier == resource.data.targetAgeTier
        && resource.data.followerAgeTier == callerAgeTier();
      allow create: if isSignedIn()
        && role() != 'parent'
        && incoming().followerId == request.auth.uid
        && incoming().followerAgeTier == callerAgeTier()
        && incoming().targetAgeTier == userAgeTier(incoming().targetId)
        && incoming().followerAgeTier == incoming().targetAgeTier
        && incoming().targetId != request.auth.uid;
      allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    match /reports/{reportId} {
      allow read: if isSignedIn() && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && incoming().reporterId == request.auth.uid
        && incoming().reporterAgeTier == callerAgeTier()
        && incoming().status == 'open';
      allow update, delete: if isAdmin();
    }

    match /moderation_queue/{itemId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /parent_controls/{studentId} {
      allow read: if isUser(studentId) || linkedTo(studentId) || isAdmin();
      allow create, update: if linkedTo(studentId)
        && incoming().studentId == studentId
        && incoming().communityEnabled is bool
        && incoming().messagingEnabled is bool
        && incoming().snapEnabled is bool;
      allow delete: if isAdmin();
    }

    // Same-tier public label. A profile with no ageTier stays readable so
    // signup can create it before the server copies the tier across.
    match /public_profiles/{userId} {
      allow read: if isSignedIn() && (
        isUser(userId)
        || resource.data.get('ageTier', '') == ''
        || resource.data.get('ageTier', '') == callerAgeTier()
      );
      allow create: if isUser(userId)
        && incoming().get('xp', 0) == 0
        && incoming().get('ageTier', '') == '';
      allow update: if isAdmin()
        || (isUser(userId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['xp', 'ageTier']));
      allow delete: if isAdmin();
    }

    match /channels/{channelId} {
      allow read: if isSignedIn() && canReadChannelData(resource.data);
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && canReadChannelData(get(/databases/$(database)/documents/channels/$(channelId)).data);
        allow create, update, delete: if false;
      }
    }

    match /tutor_profiles/{userId} {
      allow read: if isSignedIn()
        && resource.data.ageTier == 'adult'
        && resource.data.verificationStatus == 'verified';
      allow create: if isUser(userId)
        && callerAgeTier() == 'adult'
        && incoming().ageTier == 'adult'
        && incoming().verificationStatus == 'pending';
      allow update: if isUser(userId)
        && resource.data.ageTier == 'adult'
        && request.resource.data.ageTier == 'adult'
        && request.resource.data.verificationStatus == resource.data.verificationStatus
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['bio', 'subjects', 'hourlyCents', 'currency', 'updatedAt']);
      allow delete: if isAdmin();
    }

    match /tutor_bookings/{bookingId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid
        || resource.data.tutorId == request.auth.uid
        || isAdmin()
      );
      allow create, update, delete: if false;
    }

    match /tutor_reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /exam_papers/{paperId} {
      allow read: if isSignedIn()
        && resource.data.status == 'published'
        && resource.data.license in ['licensed', 'teacher_upload'];
      allow create: if isTeacherOrAdmin()
        && incoming().license == 'teacher_upload'
        && incoming().uploadedBy == request.auth.uid
        && incoming().status == 'draft';
      allow update: if isAdmin()
        || (isTeacherOrAdmin()
            && resource.data.uploadedBy == request.auth.uid
            && resource.data.license == 'teacher_upload'
            && request.resource.data.license == 'teacher_upload');
      allow delete: if isAdmin();
    }

    match /mock_attempts/{attemptId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid
        || isAdmin()
        || linkedTo(resource.data.studentId)
      );
      allow create, update, delete: if false;
    }

    match /guidance_profiles/{userId} {
      allow read: if isUser(userId) || isAdmin() || linkedTo(userId);
      allow create, update, delete: if false;
    }

    match /creator_resources/{resourceId} {
      allow read: if isSignedIn() && (
        resource.data.status == 'approved'
        || resource.data.authorId == request.auth.uid
        || isAdmin()
      );
      allow create: if isTeacherOrAdmin()
        && incoming().authorId == request.auth.uid
        && incoming().status == 'draft'
        && incoming().kind in ['note', 'worksheet', 'template'];
      allow update: if isAdmin()
        || (resource.data.authorId == request.auth.uid
            && resource.data.status in ['draft', 'pending', 'rejected']
            && request.resource.data.status in ['draft', 'pending']
            && request.resource.data.authorId == resource.data.authorId);
      allow delete: if isAdmin() || resource.data.authorId == request.auth.uid;
    }

    match /snap_sessions/{sessionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    match /lesson_questions/{questionId} {
      allow read: if isSignedIn() && (
        resource.data.authorId == request.auth.uid
        || isAdmin()
        || linkedTo(resource.data.authorId)
      );
      allow create, update, delete: if false;
    }

    // Money, secrets and webhook claims are server-only. The Admin SDK bypasses these rules.
    match /platform_secrets/{id} { allow read, write: if false; }
    match /payment_events/{id} { allow read, write: if false; }
    match /payment_links/{id} { allow read, write: if false; }
    match /checkouts/{id} { allow read, write: if false; }
    match /transactions/{id} { allow read, write: if false; }
    match /coupons/{id} { allow read, write: if false; }
    match /referrals/{code} { allow read, write: if false; }
    match /affiliate_ledger/{id} { allow read, write: if false; }
    match /refund_requests/{id} { allow read: if isAdmin(); allow write: if false; }
    match /disputes/{id} { allow read: if isAdmin(); allow write: if false; }
    match /library/{userId}/books/{bookId} {
      allow read: if isUser(userId) || isAdmin();
      allow write: if false;
    }
    match /subscriptions/{subscriptionId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || isUser(subscriptionId)
        || resource.data.get('payerUid', '') == request.auth.uid
        || resource.data.get('beneficiaryUids', []).hasAny([request.auth.uid])
        || resource.data.get('userId', '') == request.auth.uid
      );
      allow write: if false;
    }
    match /payouts/{id} {
      allow read: if isSignedIn() && (resource.data.payeeId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /tutor_offers/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /bookings/{id} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid
        || resource.data.tutorId == request.auth.uid
        || isAdmin()
      );
      allow write: if false;
    }
    match /resource_purchases/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /focus_sessions/{sessionId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid
        || isAdmin()
        || linkedTo(resource.data.studentId)
        || (isTeacherOrAdmin() && resource.data.get('courseId', '') != '' && ownsCourse(resource.data.courseId))
      );
      allow create: if isSignedIn() && incoming().studentId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.studentId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /study_events/{eventId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid
        || isAdmin()
        || linkedTo(resource.data.studentId)
        || (isTeacherOrAdmin() && resource.data.get('courseId', '') != '' && ownsCourse(resource.data.courseId))
      );
      allow create: if isSignedIn() && incoming().studentId == request.auth.uid;
      allow update, delete: if false;
    }

    match /mood_checkins/{checkinId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid
        || isAdmin()
        || linkedTo(resource.data.studentId)
        || resource.data.get('teacherIds', []).hasAny([request.auth.uid])
        || (isInstitutionAdmin()
            && resource.data.get('institutionId', '') != ''
            && resource.data.get('institutionId', '') == myInstitution())
      );
      allow create: if isSignedIn() && incoming().studentId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.studentId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /goal_suggestions/{suggestionId} {
      allow create: if isSignedIn()
        && linkedTo(incoming().studentId)
        && incoming().parentId == request.auth.uid
        && incoming().status == 'pending';
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid
        || resource.data.parentId == request.auth.uid
        || isAdmin()
      );
      allow update: if isSignedIn()
        && resource.data.studentId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if isAdmin();
    }

    match /analytics_snapshots/{snapshotId} {
      allow read: if isSignedIn() && (
        resource.data.scopeId == request.auth.uid
        || isAdmin()
        || linkedTo(resource.data.get('subjectStudentId', ''))
        || resource.data.get('teacherIds', []).hasAny([request.auth.uid])
        || (isInstitutionAdmin() && resource.data.get('institutionId', '') == myInstitution())
      );
      allow write: if false;
    }

    match /integrity_cases/{caseId} {
      allow read: if isTeacherOrAdmin()
        || (isSignedIn() && resource.data.studentId == request.auth.uid)
        || linkedTo(resource.data.studentId);
      allow create: if isTeacherOrAdmin() && incoming().automaticPenalty == false;
      allow update: if isTeacherOrAdmin()
        || (isSignedIn()
            && resource.data.studentId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['appealNote', 'appealAt', 'appealStatus'])
            && request.resource.data.appealStatus == 'submitted');
      allow delete: if isAdmin();

      match /audit/{entryId} {
        allow read: if isTeacherOrAdmin()
          || linkedTo(get(/databases/$(database)/documents/integrity_cases/$(caseId)).data.studentId)
          || get(/databases/$(database)/documents/integrity_cases/$(caseId)).data.studentId == request.auth.uid;
        allow create: if isTeacherOrAdmin() && incoming().actorId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /academic_calendars/{calendarId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacherOrAdmin();
    }

    match /calendar_drafts/{draftId} {
      allow read, create, update, delete: if isTeacherOrAdmin();
    }

    match /bloom_tags/{tagId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacherOrAdmin();
    }

    match /report_schedules/{scheduleId} {
      allow read: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid
        || isAdmin()
        || (isInstitutionAdmin() && resource.data.get('institutionId', '') == myInstitution())
      );
      allow create: if isSignedIn()
        && incoming().ownerId == request.auth.uid
        && (isTeacherOrAdmin() || role() == 'parent');
      allow update, delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Concern flags are review signals. Wellbeing stays off the institution read.
    match /concern_flags/{flagId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.studentId == request.auth.uid
        || linkedTo(resource.data.studentId)
        || resource.data.get('teacherId', '') == request.auth.uid
        || resource.data.get('teacherIds', []).hasAny([request.auth.uid])
        || (isInstitutionAdmin()
            && resource.data.get('institutionId', '') == myInstitution()
            && resource.data.kind != 'wellbeing')
      );
      allow create: if isTeacherOrAdmin() && incoming().automaticPenalty == false;
      allow update: if isTeacherOrAdmin() && resource.data.get('teacherId', '') == request.auth.uid;
      allow delete: if isAdmin();
    }

    // A re-examination answer belongs to the student. It does not change a mark.
    match /reexam_responses/{responseId} {
      allow create: if isSignedIn()
        && incoming().studentId == request.auth.uid
        && incoming().automaticPenalty == false;
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid
        || linkedTo(resource.data.studentId)
        || resource.data.teacherId == request.auth.uid
        || isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    match /notify_settings/{settingsId} {
      allow read: if isSignedIn() && (
        request.auth.uid == settingsId
        || isAdmin()
        || (isInstitutionAdmin() && settingsId == 'school_' + myInstitution())
      );
      allow create, update: if isSignedIn() && (
        (request.auth.uid == settingsId
          && incoming().quietStart is string
          && incoming().quietEnd is string)
        || (isInstitutionAdmin()
            && settingsId == 'school_' + myInstitution()
            && incoming().institutionId == myInstitution())
      );
      allow delete: if isAdmin();
    }

    match /report_templates/{templateId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || (isInstitutionAdmin() && resource.data.institutionId == myInstitution())
        || (role() == 'teacher' && resource.data.institutionId == myInstitution())
      );
      allow create, update: if isInstitutionAdmin() && incoming().institutionId == myInstitution()
        || (isAdmin() && incoming().institutionId is string);
      allow delete: if isAdmin();
    }

    // Activity log. In the repo only — deploy these rules with the owner toolchain.
    // Clients cannot create, edit, or delete a row. Super admins read the log.
    // A person can read their own sign-in rows.
    match /activity_log/{eventId} {
      allow read: if callerIsSuper()
        || (isSignedIn()
            && resource.data.actorId == request.auth.uid
            && resource.data.category == 'auth');
      allow create, update, delete: if false;
    }

    match /audit_settings/{docId} {
      allow read: if callerIsSuper();
      allow create, update, delete: if false;
    }

    // Signing key. Never readable from a client.
    match /credential_keys/{keyId} {
      allow read, write: if false;
    }

    match /certificate_templates/{templateId} {
      allow read: if isAdmin() || isInstitutionAdmin();
      allow create, update, delete: if false;
    }

    // Visual certificate designs. The server writes them with the Admin SDK.
    match /certificate_designs/{designId} {
      allow read: if isAdmin() || isInstitutionAdmin();
      allow create, update, delete: if false;
    }

    // Seat allocations. Clients cannot write them.
    match /seat_allocations/{allocationId} {
      allow read: if isAdmin() || isInstitutionAdmin();
      allow create, update, delete: if false;
    }

    // Machine translations of lessons, quizzes, books, essay feedback, and
    // teacher replies. The server writes them with the Admin SDK. Clients
    // may read one document and cannot list or edit the cache.
    match /content_translations/{docId} {
      allow get: if isSignedIn();
      allow list, create, update, delete: if false;
    }

    // Public lookup by id for the QR. Listing every card is refused.
    // Marketing journal. Super admins write. The public site reads published
    // rows with the Admin SDK, so clients cannot list the desk.
    match /blogPosts/{slug} {
      allow get: if callerIsSuper() || resource.data.status == 'published';
      allow list: if callerIsSuper();
      allow create, update: if callerIsSuper()
        && incoming().slug == slug
        && incoming().title is string
        && incoming().title.size() > 0
        && incoming().title.size() < 200
        && incoming().body is string
        && incoming().body.size() < 30000
        && incoming().status in ['draft', 'scheduled', 'published']
        && incoming().sample == false;
      allow delete: if callerIsSuper();
    }

    // Professional network, founders, groups, and safeguarding.
    // Clients may read. Writes stay on the API so ET AI can screen them.
    // In the repo only. Do not deploy these rules from this change.
    match /network_profiles/{userId} {
      allow read: if isSignedIn() && (
        isUser(userId)
        || isAdmin()
        || (resource.data.ageTier == 'adult' && resource.data.visibility == 'public')
        || (resource.data.ageTier == 'adult' && resource.data.visibility == 'network' && callerAgeTier() == 'adult')
        || (resource.data.ageTier != 'adult' && resource.data.institutionId == myInstitution())
      );
      allow create, update, delete: if false;
    }
    match /network_posts/{postId} {
      allow read: if isSignedIn() && (
        resource.data.authorId == request.auth.uid
        || isAdmin()
        || (resource.data.moderation == 'allow' && resource.data.ageTier == 'adult' && callerAgeTier() == 'adult')
        || (resource.data.moderation == 'allow' && resource.data.institutionId != '' && resource.data.institutionId == myInstitution())
      );
      allow create, update, delete: if false;
    }
    match /network_comments/{commentId} {
      allow read: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin() || resource.data.moderation == 'allow');
      allow create, update, delete: if false;
    }
    match /network_messages/{messageId} {
      allow read: if isSignedIn() && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }
    match /network_orgs/{orgId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }
    match /founder_profiles/{userId} {
      allow read: if isSignedIn() && resource.data.ageTier == 'adult' && resource.data.optIn == true && callerAgeTier() == 'adult';
      allow create, update, delete: if false;
    }
    match /startups/{startupId} {
      allow read: if isSignedIn() && callerAgeTier() == 'adult';
      allow create, update, delete: if false;
    }
    match /groups/{groupId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || (resource.data.visibility != 'secret' && (resource.data.schoolOnly != true || resource.data.institutionId == myInstitution()))
      );
      allow create, update, delete: if false;
    }
    match /group_posts/{postId} {
      allow read: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin() || resource.data.moderation == 'allow');
      allow create, update, delete: if false;
    }
    match /safeguarding_cases/{caseId} {
      allow read: if resource.data.source != 'student_safety_report'
        && resource.data.source != 'danger_now'
        && (isAdmin() || (isInstitutionAdmin() && resource.data.institutionId == myInstitution()));
      allow create, update, delete: if false;
    }
    match /safeguarding_alerts/{alertId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }
    match /moderation_audit/{itemId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /moderation_strikes/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow create, update, delete: if false;
    }
    match /moderation_appeals/{appealId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }
    match /alumni_wall_posts/{postId} {
      allow read: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin() || (resource.data.moderation == 'allow' && callerAgeTier() == 'adult'));
      allow create, update, delete: if false;
    }
    match /yearbook_notes/{noteId} {
      allow read: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin() || (resource.data.moderation == 'allow' && resource.data.institutionId == myInstitution()));
      allow create, update, delete: if false;
    }

    // Hotline and emergency alerts. Client writes are false.
    // Two-person publish is enforced in lib/server/emergency.ts. Do not deploy from this branch.
    match /hotline_tickets/{ticketId} {
      // Student safety reports and danger alerts are not client-readable.
      // The API returns a tracker or a notice. Identity stays off this path.
      allow get: if isSignedIn()
        && resource.data.source != 'student_safety_report'
        && resource.data.source != 'danger_now'
        && (resource.data.parentUid == request.auth.uid || isAdmin());
      allow list: if false;
      allow create, update, delete: if false;
      match /comments/{commentId} {
        allow read: if isSignedIn()
          && get(/databases/$(database)/documents/hotline_tickets/$(ticketId)).data.source != 'student_safety_report'
          && get(/databases/$(database)/documents/hotline_tickets/$(ticketId)).data.source != 'danger_now'
          && (
            isAdmin()
            || (resource.data.internal != true && get(/databases/$(database)/documents/hotline_tickets/$(ticketId)).data.parentUid == request.auth.uid)
          );
        allow create, update, delete: if false;
      }
      // Append-only. update and delete are false for every role, admin included.
      match /events/{eventId} {
        allow read: if isAdmin()
          && get(/databases/$(database)/documents/hotline_tickets/$(ticketId)).data.source != 'student_safety_report'
          && get(/databases/$(database)/documents/hotline_tickets/$(ticketId)).data.source != 'danger_now';
        allow create: if false;
        allow update, delete: if false;
      }
      match /attachments/{fileId} {
        allow read, write: if false;
      }
    }
    match /emergency_alerts/{alertId} {
      allow read: if false;
      allow create, update, delete: if false;
      // Append-only. update and delete are false for every role, admin included.
      match /updates/{updateId} {
        allow read: if false;
        allow create: if false;
        allow update, delete: if false;
      }
      match /audit/{auditId} {
        allow read: if isAdmin();
        allow create: if false;
        allow update, delete: if false;
      }
      match /attachments/{fileId} {
        allow read, write: if false;
      }
      match /recipients/{recipientId} {
        allow read, write: if false;
      }
      // Consent versions are append-only. update and delete are false for every role, admin included.
      match /consent/{consentId} {
        allow read: if isAdmin();
        allow create: if false;
        allow update, delete: if false;
      }
    }
    match /emergency_rate/{rateId} {
      allow read, write: if false;
    }
    match /safety_helplines/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }
    match /safety_flags/{userId} {
      allow read, write: if false;
    }
    match /safety_rate/{rateId} {
      allow read, write: if false;
    }
    match /mail_deliveries/{deliveryId} {
      allow read, write: if false;
    }
    match /all_staff_alerts/{alertId} {
      allow read, write: if false;
      match /checkins/{staffId} {
        allow read, write: if false;
      }
      match /audit/{auditId} {
        allow read: if false;
        allow create: if false;
        allow update, delete: if false;
      }
    }
    match /all_staff_open/{institutionId} {
      allow read, write: if false;
    }
    match /all_staff_instructions/{institutionId} {
      allow read, write: if false;
    }
    match /safety_desk/{docId} {
      allow read, write: if false;
    }
    match /admin_desk/{docId} {
      allow read, write: if false;
      match /audit/{entryId} {
        allow read, write: if false;
      }
    }
    match /push_broadcasts/{broadcastId} {
      allow read, write: if false;
    }
    match /helpline_config/{country} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /verification_reviews/{reviewId} {
      allow read, write: if false;
    }
    match /guardian_link_codes/{code} {
      allow read, write: if false;
    }
    match /alert_reports/{reportId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /alert_report_rate/{rateId} {
      allow read, write: if false;
    }
    match /alert_report_bans/{userId} {
      allow read: if isAdmin() || isUser(userId);
      allow create, update, delete: if false;
    }

    // Anti-bullying. Client reads and writes are false. Not deployed.
    match /evidence_locker/{itemId} {
      allow read, write: if false;
      match /events/{eventId} {
        allow read: if false;
        allow create: if false;
        allow update, delete: if false;
      }
    }
    match /school_referrals/{referralId} {
      allow read, write: if false;
    }
    match /account_limits/{userId} {
      allow read, write: if false;
    }
    match /network_restricts/{pairId} {
      allow read, write: if false;
    }
    match /network_mutes/{pairId} {
      allow read, write: if false;
    }
    // Off-platform school notices. Append-only on the server. Not deployed.
    match /schoolNotices/{noticeId} {
      allow read, write: if false;
      match /events/{eventId} {
        allow read: if false;
        allow create: if false;
        allow update, delete: if false;
      }
    }
    match /schools/{schoolId} {
      allow read, write: if false;
    }
    // Authority referrals. Append-only on the server. Not deployed.
    match /authorityReferrals/{referralId} {
      allow read, write: if false;
      match /events/{eventId} {
        allow read: if false;
        allow create: if false;
        allow update, delete: if false;
      }
    }
    // Community safety terms. The server writes legal/safetyTerms/versions/{version}.
    // Signed-in clients may read that document. They cannot write it or its audit chain. Not deployed.
    // Community partner applications. Server only. Applying grants nothing. Not deployed.
    match /communityPartnerApplications/{applicationId} {
      allow read, write: if false;
    }
    match /legal/safetyTerms {
      allow read, write: if false;
      match /versions/{version} {
        allow get: if request.auth != null;
        allow list, create, update, delete: if false;
        match /audit/{entryId} {
          allow read, write: if false;
        }
      }
    }

    // Learning-progress alerts. Clients read. The server writes through the API.
    // Parents cannot read an adult learner's alert. Deploy with the owner toolchain.
    match /progress_alerts/{alertId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.studentId == request.auth.uid
        || (linkedTo(resource.data.studentId) && resource.data.adult != true)
        || resource.data.get('teacherIds', []).hasAny([request.auth.uid])
        || resource.data.get('assigneeId', '') == request.auth.uid
        || (isInstitutionAdmin() && resource.data.get('institutionId', '') == myInstitution())
      );
      allow create, update, delete: if false;
    }

    match /progress_alert_settings/{settingsId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || (isInstitutionAdmin() && (settingsId == myInstitution() || settingsId == 'platform'))
      );
      allow create, update, delete: if false;
    }

    match /progress_alert_trends/{trendId} {
      allow read: if isSignedIn() && (isAdmin() || isInstitutionAdmin());
      allow create, update, delete: if false;
    }

    match /progress_alert_state/{studentId} {
      allow read, write: if false;
    }

    // Private recognition for responsive teachers and engaged parents.
    // The person and their institution can read it. Students cannot.
    match /progress_alert_recognition/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId
        || isAdmin()
        || (isInstitutionAdmin() && resource.data.get('institutionId', '') == myInstitution())
      );
      allow create, update, delete: if false;
    }

    match /progress_alert_wins/{winId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || (isInstitutionAdmin() && resource.data.get('institutionId', '') == myInstitution())
      );
      allow create, update, delete: if false;
    }

    // Subscriptions and entitlements. The server writes them. A person can read
    // their own row. A linked parent can read a child's entitlement. Deploy with
    // the owner toolchain. This change is not deployed from the agent.
    match /entitlements/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid
        || isAdmin()
        || linkedTo(uid)
        || resource.data.get('payerUid', '') == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    match /billing_audit/{eventId} {
      allow read: if isSignedIn() && isAdmin();
      allow create, update, delete: if false;
    }

    match /billing_audit_head/{headId} {
      allow read, write: if false;
    }

    match /billing_events/{eventId} {
      allow read, write: if false;
    }

    // Member numbers, share links, and the referral stub. The server writes
    // these with the Admin SDK. The card is free, so these rules do not look
    // at a plan or an entitlement.
    match /student_numbers/{numberId} {
      allow read, write: if false;
    }

    match /number_sequences/{sequenceId} {
      allow read, write: if false;
    }

    match /card_shares/{shareId} {
      allow read, write: if false;
    }

    match /card_audit/{eventId} {
      allow read, write: if false;
    }

    match /card_audit_head/{headId} {
      allow read, write: if false;
    }

    // Student ID, partner perks, and redemption audit. The server writes
    // these with the Admin SDK. Clients cannot read redemption rows.
    match /student_codes/{codeId} {
      allow read, write: if false;
    }

    match /student_code_limits/{uid} {
      allow read, write: if false;
    }

    match /student_code_attempts/{actorId} {
      allow read, write: if false;
    }

    match /partners/{partnerId} {
      allow read, write: if false;
    }

    match /offers/{offerId} {
      allow read, write: if false;
    }

    match /redemptions/{redemptionId} {
      allow read, write: if false;
    }

    match /perk_audit/{eventId} {
      allow read, write: if false;
    }

    match /perk_audit_head/{headId} {
      allow read, write: if false;
    }

    match /published_reports/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isTeacherOrAdmin();
      allow delete: if isAdmin();
    }
  }
}
