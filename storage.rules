rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /media/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Journal banners and inline images. The public site reads them.
    // Do not deploy from this branch.
    match /blog/{postId}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/webp';
      allow delete: if request.auth != null;
    }

    // Hotline and emergency files. Clients cannot read or write these paths.
    // The server strips location data, scans the bytes, and returns a signed URL.
    // Do not deploy from this branch.
    match /institutions/{institutionId}/hotline/{ticketId}/{fileName} {
      allow read, write: if false;
    }
    match /institutions/{institutionId}/alerts/{alertId}/{fileName} {
      allow read, write: if false;
    }
  }
}
