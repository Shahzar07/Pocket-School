# Email verification codes (signup + admin 2FA) — any SMTP provider works.
# Gmail: host smtp.gmail.com, port 587, user = your address, pass = an App Password
# (Google Account → Security → 2-Step Verification → App passwords).
# Other options: SendGrid (smtp.sendgrid.net, user "apikey"), Mailgun, Brevo, SES.
# Admin sign-in always requires a second factor. All four of SMTP_HOST, SMTP_USER,
# SMTP_PASS, and OTP_SECRET must be set or the email code is not sent. OTP_SECRET
# does not fall back to SMTP_PASS. Signup can continue without them. Admin sign-in cannot.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Pocket School <you@gmail.com>"
# Secret for signing verification codes. Required in addition to the SMTP variables.
OTP_SECRET="any-long-random-string"
# Signs the httpOnly dashboard role cookie. Falls back to OTP_SECRET when unset.
# Must be at least 16 characters. Does not grant any role by itself.
DASHBOARD_SESSION_SECRET=""
# Comma-separated super admins who may use Google or an authenticator when SMTP is unset.
# This does not grant the role by itself. Example: harry.seggu@gmail.com
SUPER_ADMIN_EMAILS=""
# Firebase Admin SDK service account JSON, as one line. Required for custom-claim
# writes and server routes that otherwise return ADMIN_NOT_CONFIGURED. Never commit it.
FIREBASE_SERVICE_ACCOUNT=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENROUTER_API_KEY: Required for all AI Studio features (flashcards, quiz, tutor, etc.)
# Get your key at https://openrouter.ai/keys — add credits to use paid models reliably.
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# Payments. Leave these empty to stay in sandbox. Do not put live keys in this file.
# Stripe: cards, Apple Pay, Google Pay, FPX, GrabPay, Billing, Connect.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# One Malaysian gateway. billplz is the default. Use test keys unless MY_GATEWAY_MODE=live.
MY_GATEWAY_PROVIDER="billplz"
MY_GATEWAY_MODE="test"
BILLPLZ_API_KEY=""
BILLPLZ_COLLECTION_ID=""
BILLPLZ_X_SIGNATURE=""
IPAY88_MERCHANT_CODE=""
IPAY88_MERCHANT_KEY=""
IPAY88_DUITNOW_PAYMENT_ID=""
RMS_MERCHANT_ID=""
RMS_VERIFY_KEY=""
RMS_SECRET_KEY=""
# MyInvois readiness. Invoices are stored. Nothing is submitted to LHDN.
MYINVOIS_CLIENT_ID=""
MYINVOIS_CLIENT_SECRET=""
# Meetings, messaging, identity, push, and AI. Flags stay off until a key exists.
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
GOOGLE_MEET_CLIENT_ID=""
GOOGLE_MEET_CLIENT_SECRET=""
# Google Calendar for the ET AI Timetabler, the school calendar, and the year planner.
# Leave these empty until the Cloud Console OAuth client exists. Do not commit real values.
# GOOGLE_OAUTH_REDIRECT_URI is the authorised redirect, such as https://poketschool.ai/api/google-calendar/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI=""
TEAMS_CLIENT_ID=""
TEAMS_CLIENT_SECRET=""
TEAMS_TENANT_ID=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
SAML_ENTRY_POINT=""
SAML_ISSUER=""
SAML_CERT=""
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
SCIM_BEARER_TOKEN=""
LTI_CLIENT_ID=""
LTI_DEPLOYMENT_ID=""
LTI_PRIVATE_KEY=""
FCM_SERVICE_ACCOUNT=""
# Legacy FCM server key. Web push with provider "fcm" no-ops when this is empty.
FCM_SERVER_KEY=""
EXPO_ACCESS_TOKEN=""
OCR_API_KEY=""
SPEECH_API_KEY=""
# Optional. payments.stripe forces Stripe on. !payments.stripe forces it off.
FEATURE_FLAGS=""
# Scheduled insights (missed goals, daily or weekly digest, snapshot refresh).
# Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=""
# HMAC secret for the free student-ID QR (a new token every 30 seconds) and the
# 6-digit checkout code. At least 16 characters. The card is never paywalled.
CARD_TOKEN_SECRET=""
# Web push stays skipped until a VAPID private key is set.
VAPID_PRIVATE_KEY=""
# OEM custom domains. SSL is attached by Vercel when the token and project id are set.
# Without them, academy settings show CNAME instructions and a manual status.
VERCEL_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""
# Sales letter at /reads/offer. Leave unset so Google cannot index it.
# Set to true and redeploy when the live page should be findable.
READS_OFFER_INDEXABLE=""
